msgstr "Tis no more."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEAFARING_PROTOTYPER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEAFARING_PROTOTYPER.GENERIC"
