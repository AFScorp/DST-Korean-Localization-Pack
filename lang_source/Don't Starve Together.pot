#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOWTHRALL_HANDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOWTHRALL_HANDS"
