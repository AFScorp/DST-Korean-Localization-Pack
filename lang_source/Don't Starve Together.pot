msgctxt "STRINGS.UI.TRADESCREEN.SKIN_COLLECTOR_SPEECH.ADDMORE.1"
msgid ""
"Help a poor old trader out with a few more <rarity> items and I'll give ya a"
" higher quality item in exchange. Guaranteed."
msgstr ""
"Help a poor old trader out with a few more <rarity> items and I'll give ya a"
" higher quality item in exchange. Guaranteed."

