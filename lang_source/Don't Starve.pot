msgstr "They picked up and left in a hurry."

#. STRINGS.CHARACTERS.WHEELER.DESCRIBE.WALRUS_CAMP.GENERIC
msgctxt "STRINGS.CHARACTERS.WHEELER.DESCRIBE.WALRUS_CAMP.GENERIC"
