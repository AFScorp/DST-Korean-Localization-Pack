msgstr "이거 받아, 괴물아!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_PARK_ANGEL2
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_PARK_ANGEL2"
