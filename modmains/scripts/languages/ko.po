msgstr "이제 준비됐어."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TOWNPORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TOWNPORTAL.GENERIC"
