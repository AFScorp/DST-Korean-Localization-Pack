msgstr "헤."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.YOT_CATCOONSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.YOT_CATCOONSHRINE.EMPTY"
