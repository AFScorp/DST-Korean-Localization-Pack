msgstr "흠. 고향 생각이 나."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_LAMP_SHORT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_LAMP_SHORT"
msgid "Enlightening."
msgstr "계몽적인데."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_MEALINGSTONE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_MEALINGSTONE"
