msgstr "배우를 극장에서 쫓아낼 수는 없겠지!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COTL_TABERNACLE_LEVEL1.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COTL_TABERNACLE_LEVEL1.GENERIC"
msgid "Aww, you want something to burn, don't you?"
msgstr "아우, 너 땔감 필요하구나, 그치?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COTL_TABERNACLE_LEVEL1.LIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COTL_TABERNACLE_LEVEL1.LIT"
msgid "That's better."
msgstr "훨씬 낫네."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COTL_TABERNACLE_LEVEL2.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COTL_TABERNACLE_LEVEL2.GENERIC"
msgid "Aww, you want something to burn, don't you?"
msgstr "아우, 너 땔감 필요하구나, 그치?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COTL_TABERNACLE_LEVEL2.LIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COTL_TABERNACLE_LEVEL2.LIT"
msgid "See? Things just look better when they're on fire."
msgstr "봤지? 뭐든지 불이 있을 때 더 멋있다니까."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COTL_TABERNACLE_LEVEL3.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COTL_TABERNACLE_LEVEL3.GENERIC"
msgid "Aww, you want something to burn, don't you?"
msgstr "아우, 너 땔감 필요하구나, 그치?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COTL_TABERNACLE_LEVEL3.LIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COTL_TABERNACLE_LEVEL3.LIT"
msgid "Burn, burn, burn!"
msgstr "타올라라, 타올라라!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COTL_TRINKET
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COTL_TRINKET"
msgid "Finder's keepers."
msgstr "발견한 사람이 임자."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COZY_BUNNYMAN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COZY_BUNNYMAN"
msgid "Ha, look at their dumb little faces!"
msgstr "하, 쟤네 저 헤벌쭉한 얼굴 좀 봐!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRABKING.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRABKING.GENERIC"
msgid "He doesn't look too happy..."
msgstr "별로 기분이 안 좋은가 본데..."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRABKING.INERT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRABKING.INERT"
msgid "I think it could use something glittery."
msgstr "반짝이는 걸 끼워넣으면 될 것 같아."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRABKING_CANNONTOWER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRABKING_CANNONTOWER"
msgid "That's not very welcoming."
msgstr "거 참 환영인사가 격하구만."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRABKING_CLAW
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRABKING_CLAW"
msgid "Keep your claws off my boat!"
msgstr "그 집게발 저리 치워!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRABKING_ICEWALL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRABKING_ICEWALL"
msgid "Ice wall? Light'er up!"
msgstr "얼음 벽? 지지면 그만이야!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRABKING_MOB
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRABKING_MOB"
msgid "What's with all the pinching?"
msgstr "뭘 그렇게 꼬집거려?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRABKING_MOB_KNIGHT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRABKING_MOB_KNIGHT"
msgid "Who ordered more crab?"
msgstr "누구 게살 사리 추가하신 분?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRITTERLAB
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRITTERLAB"
msgid "Is there anything cute in there??"
msgstr "안에 귀여운 거라도 있나??"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRITTER_BULBIN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRITTER_BULBIN"
msgid "My bulbous little buddy."
msgstr "내 땡글땡글한 꼬마 친구야."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRITTER_DRAGONLING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRITTER_DRAGONLING"
msgid "We were made for each other."
msgstr "우린 천생연분이야."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRITTER_EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRITTER_EYEOFTERROR"
msgid "Hey, looking good today!"
msgstr "이야, 너 오늘 보기 좋네!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRITTER_GLOMLING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRITTER_GLOMLING"
msgid "Aww, I could just squish your gross lil face!"
msgstr "우왕, 저 징그러운 얼굴 쭈물쭈물할래!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRITTER_KITTEN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRITTER_KITTEN"
msgid "You're the perfect lapwarmer."
msgstr "무릎 위에 올려놓기 딱 좋네."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRITTER_LAMB
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRITTER_LAMB"
msgid "Look at those creepy little eyes. Aww."
msgstr "저 소름끼치는 눈 좀 봐. 우왕."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRITTER_LUNARMOTHLING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRITTER_LUNARMOTHLING"
msgid "She loves flames!"
msgstr "얘는 불꽃을 좋아해!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRITTER_PERDLING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRITTER_PERDLING"
msgid "I could just eat you up."
msgstr "확 깨물어 주고 싶어."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRITTER_PUPPY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRITTER_PUPPY"
msgid "Hah, you don't even know you're smelly."
msgstr "하, 너한테서 냄새 나는 것도 몰랐구나."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CROW.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CROW.GENERIC"
msgid "I think it's waiting for me to die."
msgstr "내가 죽기를 기다리는 것 같아."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CROW.HELD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CROW.HELD"
msgid "Not so smart now, are you?"
msgstr "똑똑하다며?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRUMBS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRUMBS"
msgid "Haha. That little guy is losing his parts."
msgstr "하하. 쟤 몸에서 막 떨어져 나가는 거 봐."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CURSED_MONKEY_TOKEN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CURSED_MONKEY_TOKEN"
msgid "Is that a real tooth on it? Haha, cool."
msgstr "이거 진짜 이빨이 박힌 거야? 하하, 멋진데."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CUTGRASS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CUTGRASS"
msgid "Cut grass, ready for burning. Or maybe crafting."
msgstr "불쏘시개용으로 잘라둔 풀이야. 뭐 만들 때도 쓸 수 있고."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CUTLESS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CUTLESS"
msgid "At least it'll make good firewood."
msgstr "그나마 땔감으로 쓰기는 괜찮겠네."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CUTLICHEN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CUTLICHEN"
msgid "Blah, tastes like sawdust."
msgstr "퉤퉷, 톱밥 맛이야."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CUTREEDS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CUTREEDS"
msgid "Cut reeds, ready for burning. Or maybe crafting."
msgstr "불쏘시개용으로 잘라둔 갈대야. 뭐 만들 때도 쓸 수 있고."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CUTSTONE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CUTSTONE"
msgid "Perfectly squared for maximum enjoyment."
msgstr "최대한 보기 좋게 완벽한 직각이야."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DAYWALKER.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DAYWALKER.GENERIC"
msgid "You jerk! I was just trying to help!"
msgstr "이 나쁜 놈아! 도와주려 했더니만!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DAYWALKER.IMPRISONED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DAYWALKER.IMPRISONED"
msgid "Looks like somebody's having a bad day."
msgstr "고생이 많은 것 같네."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DAYWALKER2.BURIED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DAYWALKER2.BURIED"
msgid "He's going to be one cranky pig."
msgstr "분명 또 완전 괴팍해지겠지."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DAYWALKER2.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DAYWALKER2.GENERIC"
msgid "Maybe I was wrong about him."
msgstr "내가 쟤를 잘못 알고 있었나."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DAYWALKER2.HOSTILE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DAYWALKER2.HOSTILE"
msgid "Temper, temper. Some things never change."
msgstr "야, 진정 좀 해라. 진짜 하나도 안 바뀌었네."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DAYWALKER_PILLAR.EXPOSED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DAYWALKER_PILLAR.EXPOSED"
msgid "It won't break. I didn't try that hard, but still."
msgstr "부서지질 않네. 별로 많이 힘 준 건 아니지만, 그래도."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DAYWALKER_PILLAR.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DAYWALKER_PILLAR.GENERIC"
msgid "How crazy would I have to be to try and break that pillar?"
msgstr "얼마나 미친 듯이 힘을 줘야 저 기둥이 부서질까?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEADLYFEAST
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEADLYFEAST"
msgid "Fire didn't cure this dish of being nasty."
msgstr "불로 익혀도 이 지독한 녀석을 어떻게 할 수는 없었어."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEAD_SEA_BONES
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEAD_SEA_BONES"
msgid "GROSS! What if I'd stepped on it by accident?"
msgstr "우웨엑! 실수로 밟았으면 어쩔 뻔했어?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DECIDUOUSTREE.BURNING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DECIDUOUSTREE.BURNING"
msgid "YES! BURN!"
msgstr "좋아! 잘 탄다!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DECIDUOUSTREE.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DECIDUOUSTREE.BURNT"
msgid "I wish it was still burning."
msgstr "더 탔으면 좋았을 텐데."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DECIDUOUSTREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DECIDUOUSTREE.CHOPPED"
msgid "One less tree in the world."
msgstr "이 세상에서 나무 하나가 또 사라졌네."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DECIDUOUSTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DECIDUOUSTREE.GENERIC"
msgid "It looks like it would burn well."
msgstr "잘 타게 생겼네."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DECIDUOUSTREE.POISON
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DECIDUOUSTREE.POISON"
msgid "A fire would set'em straight."
msgstr "불이 저 녀석을 혼내줄 거야."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DECK_OF_CARDS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DECK_OF_CARDS"
msgid "If it's not a full deck, at least we have kindling."
msgstr "만약에 카드가 모자라면, 적어도 불쏘시개로는 쓸 수 있겠지."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DECOR_CENTERPIECE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DECOR_CENTERPIECE"
msgid "Okay."
msgstr "뭐 그래."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DECOR_FLOWERVASE.EMPTY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DECOR_FLOWERVASE.EMPTY"
msgid "It's empty. Might as well burn it."
msgstr "비어있어. 그냥 태워버릴까 봐."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DECOR_FLOWERVASE.FRESHLIGHT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DECOR_FLOWERVASE.FRESHLIGHT"
msgid "Not as good as a fire, but at least we won't be in the dark."
msgstr "불만큼 좋은 건 아니지만, 어둠에서 벗어날 수는 있을 테니까."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DECOR_FLOWERVASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DECOR_FLOWERVASE.GENERIC"
msgid "Just a bunch of dumb flowers."
msgstr "그냥 멍청한 꽃 무더기들이야."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DECOR_FLOWERVASE.OLDLIGHT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DECOR_FLOWERVASE.OLDLIGHT"
msgid "We're gonna be in the dark soon."
msgstr "금방 어둠이 드리울 거야."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DECOR_FLOWERVASE.WILTED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DECOR_FLOWERVASE.WILTED"
msgid "Those need replacing."
msgstr "갈아줘야겠어."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DECOR_LAMP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DECOR_LAMP"
msgid "A torch works just as well."
msgstr "횃불로도 충분한데 뭘."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DECOR_PICTUREFRAME.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DECOR_PICTUREFRAME.GENERIC"
msgid "It's fine."
msgstr "좋은데."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DECOR_PICTUREFRAME.UNDRAWN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DECOR_PICTUREFRAME.UNDRAWN"
msgid "My burning desire isn't to draw."
msgstr "난 딱히 예술에 대한 열정 같은 건 없는데 말야."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DECOR_PORTRAITFRAME
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DECOR_PORTRAITFRAME"
msgid "It's missing the fire in their eyes."
msgstr "이글거리는 눈빛이 빠졌잖아."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEER.ANTLER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEER.ANTLER"
msgid "Don't think that horn makes you special, deer."
msgstr "그 뿔 좀 단다고 특별해지는 일이 녹록하진 않을걸."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEER.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEER.GENERIC"
msgid "I wish everyone'd stop fawning over that smelly thing!"
msgstr "다들 저 냄새나는 자식한테 사슴없이 아부 떠는 것 좀 안 했으면!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEERCLOPS"
msgid "Holy crap!"
msgstr "이런 젠장!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEERCLOPSCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEERCLOPSCORPSE.BURNING"
msgid "Nice and toasty!"
msgstr "아주 뜨끈한데!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEERCLOPSCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEERCLOPSCORPSE.GENERIC"
msgid "That body looks cold. I should fix that."
msgstr "몸뚱이가 차가워 보이는데. 고쳐줘야지."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEERCLOPSCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEERCLOPSCORPSE.REVIVING"
msgid "That's... not good."
msgstr "이러면... 안 되는데."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.GENERIC
msgctxt ""
"STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.GENERIC"
msgid "But how will anything burn?"
msgstr "이러면 뭘 어떻게 태워?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.NOEYEBALL
msgctxt ""
"STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.NOEYEBALL"
msgid "There we go."
msgstr "다 됐다."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD_KIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD_KIT"
msgid "Fine. I'll build it. But I might burn it later."
msgstr "그래. 내가 짓지 뭐. 대신 내가 태울 거다."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEERCLOPS_EYEBALL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEERCLOPS_EYEBALL"
msgid "Stop staring at me!"
msgstr "나 좀 그만 쳐다보시지!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEER_ANTLER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEER_ANTLER"
msgid "It's a big, weird antler."
msgstr "크고 이상한 사슴뿔이야."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEER_GEMMED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEER_GEMMED"
msgid "Marginally better smelling than most animals here."
msgstr "다른 여기 동물들 대부분보다는 그나마 냄새가 좋네."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEPLETED_GRASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEPLETED_GRASS.GENERIC"
msgid "What a sorry looking piece of... grass?"
msgstr "이 형편없는 풀... 쪼가리는 뭐야?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DESERTHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DESERTHAT"
msgid "Not very stylish."
msgstr "별로 스타일 있지 않아."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DESICCANT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DESICCANT"
msgid "I love this stuff."
msgstr "이거 마음에 드는데."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DESICCANTBOOSTED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DESICCANTBOOSTED"
msgid "Moisture is the enemy!"
msgstr "습기는 나의 적!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIRTPILE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIRTPILE"
msgid "Who just leaves dirt lying around in the forest?"
msgstr "누가 숲 속에다 흙더미를 놔두는 거지?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIVININGROD.COLD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIVININGROD.COLD"
msgid "It's making some kind of noise."
msgstr "뭔가 소리가 나는 것 같아."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIVININGROD.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIVININGROD.GENERIC"
msgid "It's full of electrical junk."
msgstr "잡 전기부품으로 가득해."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIVININGROD.HOT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIVININGROD.HOT"
msgid "Gah! Enough with the beeping!"
msgstr "아으! 좀 그만 울려!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIVININGROD.WARM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIVININGROD.WARM"
msgid "This thing is getting noisier."
msgstr "소음이 점점 커지고 있어."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIVININGROD.WARMER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIVININGROD.WARMER"
msgid "Must be close!"
msgstr "가까운 게 분명해!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIVININGRODBASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIVININGRODBASE.GENERIC"
msgid "Not sure what this does. Doesn't seem like it's fiery things."
msgstr "뭐에 쓰는 건지 모르겠어. 부지깽이는 아닌 것 같고."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIVININGRODBASE.READY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIVININGRODBASE.READY"
msgid "Just needs to be unlocked with a key. Not fire, unfortunately."
msgstr "열쇠로 열 준비가 되었어. 슬프게도 불은 안 통해."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIVININGRODBASE.UNLOCKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIVININGRODBASE.UNLOCKED"
msgid "It's whirring now!"
msgstr "이제 웅웅 잘 돌아가네!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIVININGRODSTART
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIVININGRODSTART"
msgid "I'll make something out of it."
msgstr "이걸로 뭔가 찾아봐야겠어."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DOCK_KIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DOCK_KIT"
msgid "It'll be nice to cover up the water with some nice, flammable wood."
msgstr "불 잘 붙고 질 좋은 나무로 물 위를 덮는다면 참 좋겠지."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DOCK_WOODPOSTS_ITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DOCK_WOODPOSTS_ITEM"
msgid "More fuel for the fi- I mean decoration for the dock!"
msgstr "땔감에- 아니, 부두에 장식할 게 더 생겼네!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DOLL_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DOLL_BLUEPRINT"
msgid "Awww, my beefalo's gonna be so hideous and adorable!"
msgstr "아아, 내 비팔로는 아주 끔찍하고 사랑스러운 녀석이 될 거야!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONBOAT_KIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONBOAT_KIT"
msgid "Who wants to build this thing? Anyone?"
msgstr "누구 이거 만들 사람? 아무도 없어?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONBOAT_PACK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONBOAT_PACK"
msgid "All the boat junk you could ever need in one package."
msgstr "배에 들어가는 온갖 잡것들이 하나로 묶여 있어."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONBODYHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONBODYHAT"
msgid "Aww, I always get caught in the middle!"
msgstr "아이, 난 항상 가운데에서 끼인다니깐!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONCHILISALAD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONCHILISALAD"
msgid "I can't wait to eat it."
msgstr "빨리 먹고 싶어."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONFLY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONFLY"
msgid "It's filled with fire!"
msgstr "온통 불이야!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONFLYCHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONFLYCHEST.GENERIC"
msgid "I'm not sure why you'd want something that DOESN'T burn..."
msgstr "불도 안 붙는 게 왜 필요하다는 건지 원..."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONFLYCHEST.UPGRADED_STACKSIZE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONFLYCHEST.UPGRADED_STACKSIZE"
msgid "Why hide away so much potential kindling?"
msgstr "미래의 불쏘시개를 죄다 숨겨놓는다니 대체 왜?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONFLYFURNACE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONFLYFURNACE.GENERIC"
msgid "Let's turn it back on!"
msgstr "다시 불을 켜자!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONFLYFURNACE.HAMMERED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONFLYFURNACE.HAMMERED"
msgid "That's certainly a look."
msgstr "저것도 확실히 매력이야."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONFLYFURNACE.HIGH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONFLYFURNACE.HIGH"
msgid "I think I'm in love."
msgstr "나 사랑에 빠진 것 같아."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONFLYFURNACE.NORMAL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONFLYFURNACE.NORMAL"
msgid "Stick another gem in there!"
msgstr "보석 하나 더 넣자!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONFRUIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONFRUIT"
msgid "It looks sort of like a fire!"
msgstr "뭔가 불처럼 생겼어!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONFRUIT_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONFRUIT_COOKED"
msgid "It looks more like a fruit that's been in a fire now."
msgstr "이제는 불에 들어갔다 나온 과일처럼 생겼어."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONFRUIT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONFRUIT_OVERSIZED"
msgid "I wish it was a fire-breathing Dragonfruit."
msgstr "불도 뿜었으면 좋았을 텐데."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONFRUIT_SEEDS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONFRUIT_SEEDS"
msgid "Some seeds."
msgstr "씨앗 약간이야."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONHEADHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONHEADHAT"
msgid "Sooo ferocious!"
msgstr "엄~청 사납지!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONPIE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONPIE"
msgid "Fire fruit in a pie? Oh boy!"
msgstr "파이 안에 불 과일이? 어머나!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONTAILHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONTAILHAT"
msgid "I wanna be the caboose!"
msgstr "내가 꼬리칸 할래!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGON_SCALES
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGON_SCALES"
msgid "Oooooooh! I LIKE those."
msgstr "우와아아! 저거 진짜 맘에 드네."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DREADSTONE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DREADSTONE"
msgid "Eww, why does this rock feel so cold and clammy?"
msgstr "으으, 이 돌 왜 이리 차갑고 축축한 것 같지?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DREADSTONEHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DREADSTONEHAT"
msgid "Do I have to wear it? On my head??"
msgstr "이걸 쓰라고? 머리에다가??"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DREADSTONE_STACK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DREADSTONE_STACK"
msgid "It's growing from way down below."
msgstr "엄청 더 깊은 곳에서부터 자라나고 있어."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRIFTWOOD_LOG
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRIFTWOOD_LOG"
msgid "Perfect for burning."
msgstr "불 붙이기 딱이야."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRIFTWOOD_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRIFTWOOD_TREE.BURNING"
msgid "YES!"
msgstr "좋았어!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRIFTWOOD_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRIFTWOOD_TREE.BURNT"
msgid "Well, that was fun."
msgstr "뭐, 재미는 있었어."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRIFTWOOD_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRIFTWOOD_TREE.CHOPPED"
msgid "I could still burn the stump."
msgstr "그루터기도 태울 수는 있지."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRIFTWOOD_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRIFTWOOD_TREE.GENERIC"
msgid "This tree looks super weird."
msgstr "이 나무 완전 이상하게 생겼네."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRUMSTICK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRUMSTICK"
msgid "Bang on the drum all day!"
msgstr "하루 종일 씹고 뜯고!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRUMSTICK_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRUMSTICK_COOKED"
msgid "Hmm... Satisfy hunger, or bang on the drum?"
msgstr "흠... 그냥 먹을까, 맛보고 즐길까?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUG_BANANABUSH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUG_BANANABUSH"
msgid "Bananas growing outside the caves? Weird."
msgstr "동굴 밖에서 바나나가 자란다고? 이상하네."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUG_BERRYBUSH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUG_BERRYBUSH"
msgid "What's the matter, got no dirt?"
msgstr "왜 그래, 흙이 없어서 그래?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUG_BERRYBUSH_JUICY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUG_BERRYBUSH_JUICY"
msgid "What's the matter, got no dirt?"
msgstr "왜 그래, 흙이 없어서 그래?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUG_GRASS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUG_GRASS"
msgid "What's the matter, got no dirt?"
msgstr "왜 그래, 흙이 없어서 그래?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUG_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUG_MARSH_BUSH"
msgid "What's the matter, got no dirt?"
msgstr "왜 그래, 흙이 없어서 그래?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUG_MONKEYTAIL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUG_MONKEYTAIL"
msgid "It'll look so pretty when it's on fire."
msgstr "불을 붙이면 아주 예쁠 거야."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUG_SAPLING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUG_SAPLING"
msgid "What's the matter, got no dirt?"
msgstr "왜 그래, 흙이 없어서 그래?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUG_TRAP_STARFISH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUG_TRAP_STARFISH"
msgid "I knew I didn't like you."
msgstr "내 맘에 안 들 줄 진작에 알았지."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUMBBELL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUMBBELL"
msgid "Quit making stuff I can't burn!"
msgstr "안 타는 것 좀 그만 만들어!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUMBBELL_BLUEGEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUMBBELL_BLUEGEM"
msgid "Ugh! Why is it so cold?"
msgstr "으윽! 왜 이리 차가운 거야?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUMBBELL_GEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUMBBELL_GEM"
msgid "Did he really need to make it so fancy?"
msgstr "굳이 이렇게 화려하게 만들어야 했어?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUMBBELL_GOLDEN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUMBBELL_GOLDEN"
msgid "Did he really need to make it so fancy?"
msgstr "굳이 이렇게 화려하게 만들어야 했어?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUMBBELL_HEAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUMBBELL_HEAT"
msgid "Let's get you all fired up for your workout, big guy!"
msgstr "운동으로 불태워 보자고, 덩치!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUMBBELL_MARBLE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUMBBELL_MARBLE"
msgid "Did he really need to make it so fancy?"
msgstr "굳이 이렇게 화려하게 만들어야 했어?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUMBBELL_REDGEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUMBBELL_REDGEM"
msgid "Yeah! Feel the burn!!"
msgstr "좋아! 이 열기!!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DURIAN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DURIAN"
msgid "Ew, stinky!"
msgstr "으, 지독해라!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DURIAN_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DURIAN_COOKED"
msgid "Yuck, it smells just as bad cooked!"
msgstr "우웩, 완전 누렁이밥 냄새잖아!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DURIAN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DURIAN_OVERSIZED"
msgid "Of course THIS is the one that grows well..."
msgstr "역시나 얘도 참 잘 자라네..."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DURIAN_SEEDS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DURIAN_SEEDS"
msgid "Some seeds."
msgstr "씨앗 약간이야."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUSTMERINGUE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUSTMERINGUE"
msgid "Yeah, I don't think I'm THAT hungry."
msgstr "그래, 저런 거 먹을 정도까지는 아니야."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUSTMOTH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUSTMOTH"
msgid "They just clean all day? What a boring life."
msgstr "종일 청소만 한다고? 정말 따분하게 사네."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUSTMOTHDEN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUSTMOTHDEN"
msgid "It's not flammable. Not that I tried or anything."
msgstr "불은 안 붙어. 해 봤다는 건 아니고."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EARMUFFSHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EARMUFFSHAT"
msgid "Smells like rabbit butt."
msgstr "토끼 똥꼬 냄새가 나."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EEL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EEL"
msgid "I don't like the look it's giving me!"
msgstr "생긴 게 맘에 안 들어."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EEL_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EEL_COOKED"
msgid "Fire improves everything."
msgstr "불이 있으면 뭐든 좋아지지."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EGGPLANT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EGGPLANT"
msgid "Definitely not a bird."
msgstr "확실히 나뭇가지는 아니네."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EGGPLANT_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EGGPLANT_COOKED"
msgid "Using fire on it made it a tastier eggplant."
msgstr "불에 익히니까 더 맛있는 가지가 되었어."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EGGPLANT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EGGPLANT_OVERSIZED"
msgid "What am I supposed to do with all this eggplant?!"
msgstr "이따만한 가지로 뭘 하라는 거야 대체?!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EGGPLANT_SEEDS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EGGPLANT_SEEDS"
msgid "Some seeds."
msgstr "씨앗 약간이야."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ELIXIR_CONTAINER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ELIXIR_CONTAINER"
msgid "Wonder what she's got sloshing around in there."
msgstr "저 안에 뭐가 들었길래 찰랑거리는 거람?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EMBERLIGHT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EMBERLIGHT"
msgid "I made that. No big deal."
msgstr "내가 만든 거야. 별 거 아니지만."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ENDTABLE.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ENDTABLE.BURNT"
msgid "Alright, alright, so I was wrong about the hand!"
msgstr "알았어, 알았다고. 그래, 손 얘기는 내가 틀렸어!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ENDTABLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ENDTABLE.EMPTY"
msgid "I'm telling you, there's a monsterhand under that thing!"
msgstr "내가 장담하는데, 저 아래에 손 괴물이 있다니까!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ENDTABLE.FRESHLIGHT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ENDTABLE.FRESHLIGHT"
msgid "Not as good as a fire, but at least we won't be in the dark."
msgstr "불만큼 좋은 건 아니지만, 어둠에서 벗어날 수는 있을 테니까."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ENDTABLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ENDTABLE.GENERIC"
msgid "Just a bunch of dumb flowers."
msgstr "그냥 멍청한 꽃 무더기들이야."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ENDTABLE.OLDLIGHT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ENDTABLE.OLDLIGHT"
msgid "We're gonna be in the dark soon."
msgstr "금방 어둠이 드리울 거야."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ENDTABLE.WILTED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ENDTABLE.WILTED"
msgid "Those need replacing."
msgstr "갈아줘야겠어."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EVERGREEN.BURNING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EVERGREEN.BURNING"
msgid "YES! BURN!"
msgstr "좋아! 잘 탄다!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EVERGREEN.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EVERGREEN.BURNT"
msgid "I wish it was still burning."
msgstr "더 탔으면 좋았을 텐데."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EVERGREEN.CHOPPED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EVERGREEN.CHOPPED"
msgid "One less tree in the world."
msgstr "이 세상에서 나무 하나가 또 사라졌네."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EVERGREEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EVERGREEN.GENERIC"
msgid "It looks like it would burn well."
msgstr "잘 타게 생겼네."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EVERGREEN_SPARSE.BURNING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EVERGREEN_SPARSE.BURNING"
msgid "YES! BURN!"
msgstr "좋아! 잘 탄다!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EVERGREEN_SPARSE.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EVERGREEN_SPARSE.BURNT"
msgid "I wish it was still burning."
msgstr "더 탔으면 좋았을 텐데."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EVERGREEN_SPARSE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EVERGREEN_SPARSE.CHOPPED"
msgid "One less tree in the world."
msgstr "이 세상에서 나무 하나가 또 사라졌네."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EVERGREEN_SPARSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EVERGREEN_SPARSE.GENERIC"
msgid "Die in a fire!"
msgstr "타 죽어버려!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EYEBRELLAHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EYEBRELLAHAT"
msgid "Keeps the rain out your eyes and in someone else's."
msgstr "빗물이 내 눈엔 못 들어가게, 다른 놈 눈엔 들어가게."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EYEMASKHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EYEMASKHAT"
msgid "Well, looks aren't everything."
msgstr "뭐, 생긴 게 전부는 아니니까."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EYEOFTERROR"
msgid "What's your problem? Quit staring!"
msgstr "뭐 불만 있냐? 그만 째려봐!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EYEOFTERROR_MINI
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EYEOFTERROR_MINI"
msgid "Ew ew ew!!"
msgstr "으으, 으!!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EYEOFTERROR_MINI_GROUNDED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EYEOFTERROR_MINI_GROUNDED"
msgid "Squish it!!"
msgstr "밟아버려!!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EYEPLANT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EYEPLANT"
msgid "They spread like fire."
msgstr "불처럼 번지는 녀석들이야."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EYETURRET
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EYETURRET"
msgid "I wish it lit stuff on fire."
msgstr "맞추면 불이 붙었으면 좋겠는데."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EYETURRET_ITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EYETURRET_ITEM"
msgid "It's no good until it's been placed."
msgstr "어디 두기 전엔 쓸모가 없지."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FARMPLOT.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FARMPLOT.BURNT"
msgid "It was a nice finale."
msgstr "멋진 피날레였어."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FARMPLOT.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FARMPLOT.GENERIC"
msgid "Sigh. It's a pile of dirt."
msgstr "나 원. 흙더미잖아."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FARMPLOT.GROWING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FARMPLOT.GROWING"
msgid "Hurry up, dirtpile. Feed me!"
msgstr "서둘러, 흙더미야. 밥 줘!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FARMPLOT.NEEDSFERTILIZER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FARMPLOT.NEEDSFERTILIZER"
msgid "Stupid thing needs poop."
msgstr "멍청한 게 똥도 필요하고."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FARM_HOE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FARM_HOE"
msgid "Farming is so much work..."
msgstr "농사는 너무 힘들어..."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FARM_PLANT.BURNING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FARM_PLANT.BURNING"
msgid "Heh heh."
msgstr "헤헤."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FARM_PLANT.FULL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FARM_PLANT.FULL"
msgid "Took long enough."
msgstr "꽤나 오래 걸렸네."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FARM_PLANT.FULL_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FARM_PLANT.FULL_OVERSIZED"
msgid "Well that looks kind of unnatural."
msgstr "거 참 뭔가 괴상하네."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FARM_PLANT.FULL_WEED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FARM_PLANT.FULL_WEED"
msgid "Wait, what kind of vegetable is that supposed to be?"
msgstr "잠깐, 저건 또 무슨 종류의 채소지?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FARM_PLANT.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FARM_PLANT.GENERIC"
msgid "A dumb plant."
msgstr "멍청한 식물이야."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FARM_PLANT.GROWING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FARM_PLANT.GROWING"
msgid "Grow faster already!"
msgstr "당장 더 빨리 자라란 말야!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FARM_PLANT.ROTTEN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FARM_PLANT.ROTTEN"
msgid "Yeah... I'm not eating that."
msgstr "그래... 저건 안 먹을 거야."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FARM_PLANT.ROTTEN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FARM_PLANT.ROTTEN_OVERSIZED"
msgid "A big pile of stinky mush."
msgstr "냄새 나는 진창 더미야."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FARM_PLANT.SEED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FARM_PLANT.SEED"
msgid "Ugh, this is going to take ages."
msgstr "윽, 한 세월 다 가겠네."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FARM_PLOW
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FARM_PLOW"
msgid "Yeah, fight that ground!"
msgstr "그래, 땅에게 본때를 보여줘!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FARM_PLOW_ITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FARM_PLOW_ITEM"
msgid "Guess I better find a dumb spot to plant some dumb plants."
msgstr "아무래도 멍청한 식물을 심을 멍청한 곳을 찾는 게 좋겠어."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FARM_SOIL_DEBRIS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FARM_SOIL_DEBRIS"
msgid "Get outta here!"
msgstr "당장 여기서 나가!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FEATHERFAN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FEATHERFAN"
msgid "I dunno... it could put out some fires..."
msgstr "모르겠네... 이거 불도 꺼질 것 같은데..."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FEATHERHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FEATHERHAT"
msgid "A phoenix reborn!"
msgstr "불사조 환생!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FEATHERPENCIL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FEATHERPENCIL"
msgid "So what does the feather do again?"
msgstr "그러니까, 깃털이 뭔 역할을 한댔지?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FEATHER_CANARY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FEATHER_CANARY"
msgid "Canary feather. It probably smells terrible on fire."
msgstr "카나리아 깃털이야. 아마도 불에 넣으면 고약한 냄새가 나겠지."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FEATHER_CROW
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FEATHER_CROW"
msgid "Black bird feather. It probably smells terrible on fire."
msgstr "검은 새 깃털이야. 아마도 불에 넣으면 고약한 냄새가 나겠지."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FEATHER_ROBIN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FEATHER_ROBIN"
msgid "Redbird feather. It probably smells terrible on fire."
msgstr "홍관조 깃털이야. 아마도 불에 넣으면 고약한 냄새가 나겠지."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FEATHER_ROBIN_WINTER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FEATHER_ROBIN_WINTER"
msgid "Snowbird feather. It probably smells terrible on fire."
msgstr "눈새 깃털이야. 아마도 불에 넣으면 고약한 냄새가 나겠지."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FEM_PUPPET
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FEM_PUPPET"
msgid "She looks scared half to death."
msgstr "무서워서 반쯤 넋이 나간 모양이야."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FENCE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FENCE"
msgid "I'm not painting that."
msgstr "난 울타리 칠 안 할 거야."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FENCE_ELECTRIC.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FENCE_ELECTRIC.GENERIC"
msgid "Dumb post."
msgstr "멍청한 기둥."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FENCE_ELECTRIC.LINKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FENCE_ELECTRIC.LINKED"
msgid "Better not shock me!"
msgstr "나 지지기만 해 봐!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FENCE_ELECTRIC_ITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FENCE_ELECTRIC_ITEM"
msgid "It's useless like that."
msgstr "이래서는 쓸모가 없잖아."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FENCE_GATE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FENCE_GATE"
msgid "I guess we could pen stuff in with it."
msgstr "이걸로 여러가지 가둬둘 수 있긴 하겠네."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FENCE_GATE_ITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FENCE_GATE_ITEM"
msgid "No point just leaving it on the ground."
msgstr "땅에 내팽개쳐 두면 무슨 소용이겠어."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FENCE_ITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FENCE_ITEM"
msgid "No point just leaving it on the ground."
msgstr "땅에 내팽개쳐 두면 무슨 소용이겠어."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FENCE_JUNK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FENCE_JUNK"
msgid "Not the prettiest fence in the world, but it works."
msgstr "영 예쁘지는 않지만, 그래도 쓸모는 있네."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FENCE_ROTATOR
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FENCE_ROTATOR"
msgid "I'm gonna go fight a fence!"
msgstr "울타리랑 싸워야지!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FERTILIZER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FERTILIZER"
msgid "A bucket full of nasty."
msgstr "더러운 것들로 가득 찬 양동이야."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FESTIVEFISH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FESTIVEFISH"
msgid "It's just so festive!"
msgstr "명절 분위기 제대로네!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FESTIVE_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FESTIVE_BLUEPRINT"
msgid "It needs more firecrackers before I'd call it \"festive\"."
msgstr "축제에 폭죽이 빠지는 건 말도 안 되지."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIG
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIG"
msgid "Looks like old people fruit."
msgstr "늙은이들 취향 과일 같은데."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIGATONI
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIGATONI"
msgid "I won't turn down a plate of pasta."
msgstr "파스타라면 사양할 리가 없지."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIGKABAB
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIGKABAB"
msgid "When I'm done with the food I can burn the stick!"
msgstr "다 먹고 나면 꼬치는 태울 수 있어!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIG_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIG_COOKED"
msgid "As usual, fire made it better."
msgstr "언제나처럼 불에 익히니 맛이 좋아졌어."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREBALLSTAFF
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREBALLSTAFF"
msgid "So I just wave it and FIRE APPEARS?"
msgstr "그러니까 그냥 휘드르기만 하면 불이 생긴다고?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIRECRACKERS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIRECRACKERS"
msgid "Light'em up!"
msgstr "불 붙이자!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREFLIES.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREFLIES.GENERIC"
msgid "I wish they didn't run away!"
msgstr "도망가지 좀 않았으면 좋겠네!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREFLIES.HELD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREFLIES.HELD"
msgid "They're like little fires in my pocket!"
msgstr "주머니 속에 작은 불이 들어있는 것 같아!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREHOUND
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREHOUND"
msgid "I actually kind of like that one."
msgstr "사실 쟤네들은 나름 맘에 들어."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIRENETTLES
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIRENETTLES"
msgid "What do you mean it's a weed? Looks like an improvement to me!"
msgstr "잡초라니 무슨 소리야? 훨씬 더 좋아보이는데!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIRENETTLES_DRIED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIRENETTLES_DRIED"
msgid "Mmm... So dry. So flammable."
msgstr "으음... 잘 말랐네. 잘 타겠어."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREPEN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREPEN"
msgid "Hey, I'm feeling really inspired to write!"
msgstr "이야, 이거 작문이 막 땡기는데!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREPIT.EMBERS"
msgid "Uh oh. It's almost gone!"
msgstr "어머 이런. 꺼지려고 그러네!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREPIT.GENERIC"
msgid "I could watch it for hours."
msgstr "얼마든지 쳐다볼 수 있어."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREPIT.HIGH"
msgid "BURN! BURN FASTER!"
msgstr "잘 탄다! 더 빨리!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREPIT.LOW"
msgid "This fire is small and boring."
msgstr "작고 지루한 불이야."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREPIT.NORMAL"
msgid "Burn!"
msgstr "잘 탄다!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREPIT.OUT"
msgid "Make the fire come back!"
msgstr "다시 불 피우자!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIRESTAFF
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIRESTAFF"
msgid "That's my absolute favorite toy."
msgstr "완전 내 취향의 장난감이야."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIRESUPPRESSOR.LOWFUEL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIRESUPPRESSOR.LOWFUEL"
msgid "Almost out."
msgstr "거의 다 됐어."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIRESUPPRESSOR.OFF
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIRESUPPRESSOR.OFF"
msgid "And stay off!"
msgstr "가만히 있어!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIRESUPPRESSOR.ON
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIRESUPPRESSOR.ON"
msgid "I wish you'd shut your lid and stop putting out fires."
msgstr "입 좀 다물고 불 좀 그만 꺼트리시지."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FISH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FISH"
msgid "Slippery fishy!"
msgstr "미끌미끌 비릿비릿!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FISHINGNET
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FISHINGNET"
msgid "I love throwing things to catch other things!"
msgstr "난 물건을 던져서 뭔가 잡는 게 정말 좋더라!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FISHINGROD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FISHINGROD"
msgid "Fishing for the answer with a hook, line and sinker."
msgstr "난 세월을 낚겠다 이거야."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FISHMEAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FISHMEAT"
msgid "Needs fire!"
msgstr "불이 필요해!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FISHMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FISHMEAT_COOKED"
msgid "Less slippery now that it's found fire."
msgstr "불을 만나서 이제 덜 미끈거려."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FISHMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FISHMEAT_DRIED"
msgid "It's fishy, real fishy."
msgstr "비린내, 어우 비린내."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FISHMEAT_SMALL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FISHMEAT_SMALL"
msgid "I like sushi, but I prefer it flame-broiled."
msgstr "초밥도 좋긴 한데, 난 직화구이가 더 좋더라."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FISHMEAT_SMALL_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FISHMEAT_SMALL_COOKED"
msgid "Fish and fire go well together."
msgstr "생선과 불은 궁합이 좋아."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FISHMEAT_SMALL_DRIED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FISHMEAT_SMALL_DRIED"
msgid "It's fishy, real fishy."
msgstr "비린내, 어우 비린내."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FISHSTICKS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FISHSTICKS"
msgid "What you see is what you get. Sticks of fish."
msgstr "보는 그대로야. 생선 튀긴 거."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FISHTACOS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FISHTACOS"
msgid "Convenient taco-grip."
msgstr "편하게 들고 먹을 수 있어."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FISH_BOX
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FISH_BOX"
msgid "Did we just... put a hole in the boat?"
msgstr "그러니까... 배에 구멍을 뚫었다는 거야?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FISH_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FISH_COOKED"
msgid "Less slippery now that it's found fire."
msgstr "불을 만나서 이제 덜 미끈거려."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLINT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLINT"
msgid "The poor man's fire-starter."
msgstr "가난한 사람들의 점화장치야."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLOATINGLANTERN.DEFLATED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLOATINGLANTERN.DEFLATED"
msgid "Sigh."
msgstr "아이."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLOATINGLANTERN.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLOATINGLANTERN.GENERIC"
msgid "Fire is magic!"
msgstr "불은 마법이야!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLOATINGLANTERN.HELD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLOATINGLANTERN.HELD"
msgid "I'd hate to share this."
msgstr "뭔가 같이 보기 아까운데."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLOTATIONCUSHION
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLOTATIONCUSHION"
msgid "Oh good, I hate drowning."
msgstr "잘 됐네. 물에 빠져 죽기 싫었는데."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLOWER.GENERIC"
msgid "I don't have time to waste on flowers."
msgstr "꽃 따위에 낭비할 시간 없어."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLOWER.ROSE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLOWER.ROSE"
msgid "I'd like to burn this flower in particular."
msgstr "유독 불 지르고 싶게 생겼어."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLOWERHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLOWERHAT"
msgid "A halo of flowers. Too bad it's not a burning halo of flowers."
msgstr "화관이야. 화관이 그 화관이 아니라서 아쉽네."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLOWERSALAD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLOWERSALAD"
msgid "I'd rather a bowl of flames."
msgstr "불그릇이 더 좋은데."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLOWER_CAVE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLOWER_CAVE"
msgid "It's burning inside."
msgstr "속에서 타들어가고 있어."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLOWER_CAVE_WITHERED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLOWER_CAVE_WITHERED"
msgid "It's inner flame is dying."
msgstr "저 안의 불꽃이 꺼지고 있어."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLOWER_EVIL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLOWER_EVIL"
msgid "Ugh, that smells terrible."
msgstr "윽, 끔찍한 냄새가 나."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLOWER_WITHERED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLOWER_WITHERED"
msgid "Looks like good kindling."
msgstr "불쏘시개로 좋겠네."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FOLIAGE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FOLIAGE"
msgid "Fuel for the fire."
msgstr "불에 넣을 연료야."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FOLIAGE_DRIED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FOLIAGE_DRIED"
msgid "Mmm... So dry. So flammable."
msgstr "으음... 잘 말랐네. 잘 타겠어."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FOOTBALLHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FOOTBALLHAT"
msgid "Sports are hard."
msgstr "운동은 힘들어."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FORGETMELOTS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FORGETMELOTS"
msgid "Some more dumb flowers."
msgstr "또 멍청한 꽃이네."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FORGETMELOTS_DRIED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FORGETMELOTS_DRIED"
msgid "Mmm... So dry. So flammable."
msgstr "으음... 잘 말랐네. 잘 타겠어."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FORMAL_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FORMAL_BLUEPRINT"
msgid "Ugh, it looks so stuffy and proper."
msgstr "윽, 너무 답답하고 딱딱하잖아."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FOSSIL_PIECE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FOSSIL_PIECE"
msgid "It's just nasty old bits of bones!"
msgstr "그냥 더럽고 오래된 뼛조각이잖아!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FOSSIL_STALKER.COMPLETE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FOSSIL_STALKER.COMPLETE"
msgid "Looks passable."
msgstr "그럭저럭 괜찮네."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FOSSIL_STALKER.FUNNY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FOSSIL_STALKER.FUNNY"
msgid "That looks absolutely ridiculous."
msgstr "정말 우스꽝스러워."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FOSSIL_STALKER.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FOSSIL_STALKER.GENERIC"
msgid "Needs more gross old bits."
msgstr "더럽고 오래된 뼛조각이 더 필요해."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FRESHFRUITCREPES
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FRESHFRUITCREPES"
msgid "Ooo la la."
msgstr "어머나 이런."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FRIENDLYFRUITFLY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FRIENDLYFRUITFLY"
msgid "Hey, this one's actually helping!"
msgstr "이야, 얘는 또 진짜 도움이 되네!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FROG.DEAD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FROG.DEAD"
msgid "Showed him!"
msgstr "본때를 봤겠지!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FROG.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FROG.GENERIC"
msgid "He's too damp to burn."
msgstr "태우기엔 너무 축축해."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FROG.SLEEPING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FROG.SLEEPING"
msgid "They're cute when they're sleeping."
msgstr "자고 있을 땐 귀여워."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FROGFISHBOWL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FROGFISHBOWL"
msgid "Woah, that's a ton of frogs."
msgstr "어우, 개구리가 한가득이네."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FROGGLEBUNWICH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FROGGLEBUNWICH"
msgid "If you close your eyes it's a little easier to get it down."
msgstr "눈 질끈 감으면 그나마 살짝 삼킬 만해."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FROGLEGS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FROGLEGS"
msgid "It still twitches every now and then. Freaky."
msgstr "아직도 슬쩍슬쩍 꿈틀거리잖아. 기괴해."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FROGLEGS_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FROGLEGS_COOKED"
msgid "The fire made it stop twitching. Fire is the best."
msgstr "불에 넣었다 빼니 더는 꿈틀대지 않아. 불이 최고라니까."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FROGNEWTON
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FROGNEWTON"
msgid "All that fig almost masks the frog flavor."
msgstr "무화과 덕에 개구리 맛이 거의 감춰져."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FROZENBANANADAIQUIRI
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FROZENBANANADAIQUIRI"
msgid "Ew, it's cold."
msgstr "으, 찬 거잖아."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FRUITDRAGON.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FRUITDRAGON.GENERIC"
msgid "They're pretty cute."
msgstr "쟤네들 되게 귀엽다."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FRUITDRAGON.RIPE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FRUITDRAGON.RIPE"
msgid "Mmm... Roast dragonfruit."
msgstr "으음... 구운 용과잖아."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FRUITDRAGON.SLEEPING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FRUITDRAGON.SLEEPING"
msgid "Good night, little guy."
msgstr "잘 자, 꼬마 친구."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FRUITFLY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FRUITFLY"
msgid "Get lost, you dumb bugs!"
msgstr "저리 꺼져, 이 멍청한 벌레 녀석들아!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FRUITFLYFRUIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FRUITFLYFRUIT"
msgid "Now I'm the one giving the orders! To fruit flies, but still."
msgstr "이제 내가 대장이다! 물론 초파리한테만이지만."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FRUITMEDLEY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FRUITMEDLEY"
msgid "Yum, fruit!"
msgstr "맛있는 과일이잖아!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FURTUFT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FURTUFT"
msgid "Black and white and fuzzy all over!"
msgstr "검은색, 흰색, 곱슬곱슬!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FUSED_SHADELING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FUSED_SHADELING"
msgid "Eww, it's so creepy!"
msgstr "으으, 소름 끼쳐!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FUSED_SHADELING_BOMB
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FUSED_SHADELING_BOMB"
msgid "They sure go out with a bang."
msgstr "녀석들 진짜 빵 터지네."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GARGOYLE_HOUND
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GARGOYLE_HOUND"
msgid "Lookit this big dumb lawn ornament!"
msgstr "저 크고 멍청한 뒤뜰 장식 좀 봐봐!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GARGOYLE_WEREPIG
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GARGOYLE_WEREPIG"
msgid "At least it doesn't smell anymore."
msgstr "적어도 냄새는 안 나게 됐네."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GARLIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GARLIC"
msgid "It's just a couple cloves of garlic."
msgstr "그냥 마늘 두 쪽이야."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GARLIC_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GARLIC_COOKED"
msgid "Fire made it better."
msgstr "불을 가하니 나아졌어."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GARLIC_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GARLIC_OVERSIZED"
msgid "I bet my breath would smell great if I ate the whole thing."
msgstr "이거 하나 다 먹으면 입냄새가 아주 끝내줄 것 같은데."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GARLIC_SEEDS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GARLIC_SEEDS"
msgid "It's just a bunch of seeds."
msgstr "그냥 씨앗 더미야."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GAZPACHO
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GAZPACHO"
msgid "I prefer hot food."
msgstr "난 뜨거운 음식이 좋은데."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GEARS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GEARS"
msgid "These must make them move."
msgstr "서로가 서로를 움직이게 해야 해."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GELBLOB.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GELBLOB.GENERIC"
msgid "Yuck. No, thank you."
msgstr "우웩. 저런 건 사절이야."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GELBLOB.HAS_CHARACTER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GELBLOB.HAS_CHARACTER"
msgid "Maybe I should help."
msgstr "도와줘야 할 것 같은데."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GELBLOB.HAS_ITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GELBLOB.HAS_ITEM"
msgid "Whatever is in there, I don't want it that badly."
msgstr "뭔지는 몰라도 그렇게까지 갖고 싶지는 않아."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GELBLOB_BOTTLE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GELBLOB_BOTTLE"
msgid "I won't mistake that for jam."
msgstr "잼이랑 헷갈리면 안 되겠다."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GELBLOB_STORAGE.FULL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GELBLOB_STORAGE.FULL"
msgid "I guess it's working?"
msgstr "효과가 있는 건가?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GELBLOB_STORAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GELBLOB_STORAGE.GENERIC"
msgid "There's nothing in goop."
msgstr "끈끈이 속에 아무 것도 없어."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GELBLOB_STORAGE_KIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GELBLOB_STORAGE_KIT"
msgid "Talk about re-purposing."
msgstr "새로운 용도라."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GEMSOCKET.GEMS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GEMSOCKET.GEMS"
msgid "It's so empty!"
msgstr "너무 허전하잖아!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GEMSOCKET.VALID
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GEMSOCKET.VALID"
msgid "I wonder how they hover?"
msgstr "어떻게 허공에 떠 있는 거지?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GENERIC_CORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GENERIC_CORPSE.BURNING"
msgid "Ahhh, that's better."
msgstr "아, 좀 낫네."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GENERIC_CORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GENERIC_CORPSE.GENERIC"
msgid "Gross!"
msgstr "징그러워!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GENERIC_CORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GENERIC_CORPSE.REVIVING"
msgid "Yup, preventable."
msgstr "그래, 막아야지."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GESTALT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GESTALT"
msgid "It feels like they're speaking inside my head!"
msgstr "마치 쟤가 내 머릿속에서 말을 거는 것 같아!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GESTALT_CAGE.FILLED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GESTALT_CAGE.FILLED"
msgid "Ha! Gotcha!"
msgstr "하! 잡았다!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GESTALT_CAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GESTALT_CAGE.GENERIC"
msgid "Empty!"
msgstr "비었네!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GESTALT_GUARD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GESTALT_GUARD"
msgid "They sure hate those shadow creeps."
msgstr "저 그림자 녀석들을 정말 싫어하나 봐."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GESTALT_GUARD_EVOLVED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GESTALT_GUARD_EVOLVED"
msgid "What did I ever do to you?"
msgstr "내가 뭘 잘못했다고 그래?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GHOST
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GHOST"
msgid "You can't kill what's already dead."
msgstr "이미 죽은 건 죽일 수 없잖아."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GHOSTFLOWER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GHOSTFLOWER"
msgid "Great. Another spooky flower."
msgstr "얼씨구. 또 무서운 꽃이네."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GHOSTFLOWERHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GHOSTFLOWERHAT"
msgid "Pretty. I guess."
msgstr "예쁜 것은 같네."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GHOSTLYELIXIR_ATTACK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GHOSTLYELIXIR_ATTACK"
