msgstr "음. 나무네."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MASHEDPOTATOES
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MASHEDPOTATOES"
