msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SLINGSHOTAMMO_MARBLE"
msgid "Remember to clean up after yourself, dear."
msgstr "있던 자리는 꼭 정리하려무나."

