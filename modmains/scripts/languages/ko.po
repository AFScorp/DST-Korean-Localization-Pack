msgstr "쇠벌레가 화났어."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_CENTIPEDE_HUSK
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_CENTIPEDE_HUSK"
msgid "Is big pile of junk."
msgstr "커다란 고철 더미야."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_COOKPOT.BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_COOKPOT.BURNT"
msgid "Pot is dead."
msgstr "냄비가 죽었어."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_COOKPOT.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_COOKPOT.COOKING_LONG"
