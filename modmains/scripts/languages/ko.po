"+1 mult"
msgstr ""
"패에 있는 Q 1장당\n"
"배율 +1"

#. STRINGS.BALATRO.JOKER_WIGFRID
msgctxt "STRINGS.BALATRO.JOKER_WIGFRID"
msgid ""
"Each Spade in hand\n"
"+25 chips"
msgstr ""
"패에 있는 ♠ 1장당\n"
"칩 +25"

#. STRINGS.BALATRO.JOKER_WILLOW
msgctxt "STRINGS.BALATRO.JOKER_WILLOW"
msgid ""
"Each face card discarded\n"
"+20 chips"
msgstr ""
"버린 K, Q, J 1장당\n"
"칩 +20"

#. STRINGS.BALATRO.JOKER_WILSON
msgctxt "STRINGS.BALATRO.JOKER_WILSON"
msgid ""
"Each pair in hand\n"
"+3 mult"
msgstr ""
"패에 있는 페어 1개당\n"
"배율 +3"

#. STRINGS.BALATRO.JOKER_WINONA
msgctxt "STRINGS.BALATRO.JOKER_WINONA"
msgid ""
"Each heart kept\n"
"+1 mult"
msgstr ""
"버리지 않은 ♥ 1장당\n"
"배율 +1"

#. STRINGS.BALATRO.JOKER_WOLFGANG
msgctxt "STRINGS.BALATRO.JOKER_WOLFGANG"
msgid ""
"Each King in hand\n"
"+25 chips"
msgstr ""
"패에 있는 킹 1장당\n"
"칩 +25"

#. STRINGS.BALATRO.JOKER_WOODIE
msgctxt "STRINGS.BALATRO.JOKER_WOODIE"
msgid ""
"Each card discarded\n"
"+7 chips"
msgstr ""
"버린 카드 1장당\n"
"칩 +7"

#. STRINGS.BALATRO.JOKER_WORMWOOD
msgctxt "STRINGS.BALATRO.JOKER_WORMWOOD"
msgid ""
"Each club kept\n"
"+15 chips"
msgstr ""
"버리지 않은 ♣ 1장당\n"
"칩 +15"

#. STRINGS.BALATRO.JOKER_WORTOX
msgctxt "STRINGS.BALATRO.JOKER_WORTOX"
msgid ""
"Each heart discarded +15 chips\n"
"Each heart in hand -11 chips +1 mult"
msgstr ""
"버린 ♥ 1장당 칩 +15\n"
"패에 있는 ♥ 1장당 칩 -11, 배율 +1"

#. STRINGS.BALATRO.JOKER_WURT
msgctxt "STRINGS.BALATRO.JOKER_WURT"
msgid ""
"Each face card kept\n"
"+10 chips per face card"
msgstr ""
"버리지 않은 K, Q, J 1장당\n"
"칩 +10"

#. STRINGS.BALATRO.JOKER_WX78
msgctxt "STRINGS.BALATRO.JOKER_WX78"
msgid ""
"Each heart kept once\n"
"then discarded +2 mult"
msgstr ""
"가지고 있다 버린 ♥\n"
"1장당 배율 +2"

