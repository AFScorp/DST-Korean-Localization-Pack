msgstr "작동 준비됐어!"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.CHARGE_FROM.NOT_ENOUGH_CHARGE
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.CHARGE_FROM.NOT_ENOUGH_CHARGE"
