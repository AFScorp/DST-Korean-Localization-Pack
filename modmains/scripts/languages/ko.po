msgstr "오래 걸릴 거야."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_COOKPOT.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_COOKPOT.COOKING_SHORT"
msgid "Is almost cook!"
msgstr "거의 다 요리됐어!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_COOKPOT.DONE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_COOKPOT.DONE"
