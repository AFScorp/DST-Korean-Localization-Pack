#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SCULPTINGTABLE.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SCULPTINGTABLE.BURNT"
msgid "Haha!"
msgstr "하하!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SCULPTINGTABLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SCULPTINGTABLE.EMPTY"
