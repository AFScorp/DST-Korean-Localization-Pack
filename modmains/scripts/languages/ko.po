#. STRINGS.BALATRO.JOKER_MAXWELL
msgctxt "STRINGS.BALATRO.JOKER_MAXWELL"
msgid ""
"Each heart discarded\n"
"+1 mult"
msgstr ""
"버린 ♥ 1장당\n"
"배율 +1"

#. STRINGS.BALATRO.JOKER_WALTER
msgctxt "STRINGS.BALATRO.JOKER_WALTER"
msgid ""
"For each different suit\n"
"in discard +15 chips"
msgstr ""
"버린 카드의 문양\n"
"1가지당 칩 +15"

#. STRINGS.BALATRO.JOKER_WANDA
msgctxt "STRINGS.BALATRO.JOKER_WANDA"
msgid ""
"Start with 80 chips\n"
"Each discard -15 chips"
msgstr ""
"80칩을 얻고 시작\n"
"버린 카드 1장당 칩 -15"

#. STRINGS.BALATRO.JOKER_WARLY
msgctxt "STRINGS.BALATRO.JOKER_WARLY"
msgid ""
"Hand contains a heart, a club\n"
"a diamond and a spade +4 mult"
msgstr ""
"패에 모든 종류의 문양이\n"
"전부 있을 시 배율 +4"

#. STRINGS.BALATRO.JOKER_WEBBER
msgctxt "STRINGS.BALATRO.JOKER_WEBBER"
msgid ""
"Each Heart or Diamond replaced\n"
"by a club or spade +2 mult"
msgstr ""
"♥ 또는 ◆를 버렸을 때\n"
"♣ 또는 ♠로 교체되면 배율 +2"

#. STRINGS.BALATRO.JOKER_WENDY
msgctxt "STRINGS.BALATRO.JOKER_WENDY"
msgid ""
"Each discard that becomes\n"
"the same suit +5 chips +2 mult"
msgstr ""
"버린 카드와 교체된 카드가\n"
"문양이 일치하면 칩 +5 배율 +2"

#. STRINGS.BALATRO.JOKER_WES
msgctxt "STRINGS.BALATRO.JOKER_WES"
msgid ""
"Hand is worse after discard\n"
"+30 chips"
msgstr ""
"카드를 버린 뒤 족보가 낮아지면\n"
"칩 +30"

#. STRINGS.BALATRO.JOKER_WICKERBOTTOM
