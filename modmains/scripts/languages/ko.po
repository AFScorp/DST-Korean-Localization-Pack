msgstr "숨을 곳이 어째 부족한데."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.ACTIVATE.KITCOON_HIDEANDSEEK_ONE_GAME_PER_DAY
msgctxt ""
"STRINGS.CHARACTERS.WINONA.ACTIONFAIL.ACTIVATE.KITCOON_HIDEANDSEEK_ONE_GAME_PER_DAY"
msgid "They look pretty tired, let's see if they wanna play again tomorrow."
msgstr "많이 피곤한 것 같은데, 내일 다시 놀 수 있을지 물어봐야겠어."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.ACTIVATE.LOCKED_GATE
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.ACTIVATE.LOCKED_GATE"
msgid "Can't get in yet."
msgstr "아직 못 들어가."

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.ACTIVATE.MANNEQUIN_EQUIPSWAPFAILED
msgctxt ""
"STRINGS.CHARACTERS.WINONA.ACTIONFAIL.ACTIVATE.MANNEQUIN_EQUIPSWAPFAILED"
msgid "Just kiddin'!"
msgstr "농담이야!"

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.ACTIVATE.NOCARNIVAL
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.ACTIVATE.NOCARNIVAL"
msgid "Looks like the party's over. Back to work, everyone!"
