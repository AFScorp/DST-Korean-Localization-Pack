msgstr "패킷"

#. STRINGS.KITCOON_NAMING.NAMES.3
msgctxt "STRINGS.KITCOON_NAMING.NAMES.3"
msgid "Lilly"
msgstr "릴리"

#. STRINGS.KITCOON_NAMING.NAMES.30
msgctxt "STRINGS.KITCOON_NAMING.NAMES.30"
msgid "Giles"
msgstr "길스"

#. STRINGS.KITCOON_NAMING.NAMES.31
msgctxt "STRINGS.KITCOON_NAMING.NAMES.31"
msgid "Brisa"
msgstr "브리사"

#. STRINGS.KITCOON_NAMING.NAMES.32
msgctxt "STRINGS.KITCOON_NAMING.NAMES.32"
msgid "Norman"
msgstr "노먼"

#. STRINGS.KITCOON_NAMING.NAMES.33
msgctxt "STRINGS.KITCOON_NAMING.NAMES.33"
msgid "Odin"
msgstr "오딘"

#. STRINGS.KITCOON_NAMING.NAMES.34
