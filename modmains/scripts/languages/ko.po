msgstr "흐음. 그 가면이랑 같이 쓰면 어울리겠는데."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COSTUME_QUEEN_BODY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COSTUME_QUEEN_BODY"
msgid "Looks like a Queen's costume."
msgstr "여왕 의상인 것 같아."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COSTUME_TREE_BODY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COSTUME_TREE_BODY"
msgid "Looks like a tree costume."
msgstr "나무 의상인 것 같아."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COTL_TABERNACLE_LEVEL1.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COTL_TABERNACLE_LEVEL1.GENERIC"
