msgstr "아이고, 까다롭네 참!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.LOWER_SAIL_FAIL.3
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.LOWER_SAIL_FAIL.3"
