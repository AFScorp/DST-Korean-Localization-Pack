#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ROYALTY_JOKER.2
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ROYALTY_JOKER.2"
msgid "Your Mirthfulness!"
msgstr "명랑한 분이시여!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ROYALTY_JOKER.3
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ROYALTY_JOKER.3"
msgid "Your \"Grace\"!"
msgstr "\"은혜\"로운 분이시여!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_RUINS_RESET
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_RUINS_RESET"
msgid "Monsters is back!"
msgstr "괴물들이 돌아왔어!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_SACREDCHEST_NO
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_SACREDCHEST_NO"
msgid "It did not like me."
msgstr "날 좋아하지 않았어."

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_SACREDCHEST_YES
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_SACREDCHEST_YES"
