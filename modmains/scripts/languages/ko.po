msgstr "아주 갔네 갔어."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MANDRAKE_PLANTED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MANDRAKE_PLANTED"
msgid "That's a weird shrub."
msgstr "이상한 풀이네."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MANRABBIT_TAIL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MANRABBIT_TAIL"
