#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTC_CARRAT_SCALE_ITEM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTC_CARRAT_SCALE_ITEM"
msgid "Is measurer of racing mightiness!"
msgstr "달리기의 강함을 재는 도구다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTC_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTC_SEEDPACKET"
msgid "Is seeds for growing."
msgstr "심을 수 있는 씨앗이야."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTC_SEEDPACKET_RARE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTC_SEEDPACKET_RARE"
msgid "Is fancy seeds for growing."
msgstr "심을 수 있는 멋진 씨앗이야."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTD_ANCHOR
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTD_ANCHOR"
msgid "Ha! Shiny anchor is not heavy for Wolfgang!"
msgstr "하! 빛나는 닻도 볼프강은 안 무거워!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTD_ANCHOR_ITEM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTD_ANCHOR_ITEM"
msgid "Is for making big boat weight."
msgstr "커다란 배 아령 만드는 데 쓰는 거다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTD_DRAGONSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTD_DRAGONSHRINE.BURNT"
msgid "Is very sad."
msgstr "너무 슬프다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTD_DRAGONSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTD_DRAGONSHRINE.EMPTY"
msgid "Is wanting burnt tree bits to nibble?"
msgstr "불에 탄 나무 조각 먹고 싶은 건가?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTD_DRAGONSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTD_DRAGONSHRINE.GENERIC"
msgid "Look! Is shiny little kill beast."
msgstr "봐! 작고 번쩍거리는 살인 짐승이야."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTD_OAR
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTD_OAR"
msgid "Stand back and watch the mighty rowing of Wolfgang!"
msgstr "뒤로 물러나서 볼프강의 힘찬 노 젓기 잘 봐!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTD_STEERINGWHEEL
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTD_STEERINGWHEEL"
msgid "Wolfgang likes steering shiny captain wheel."
msgstr "볼프강은 번쩍거리는 선장 바퀴 돌리는 거 좋다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTD_STEERINGWHEEL_ITEM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTD_STEERINGWHEEL_ITEM"
msgid "Is for making little whirly steer-wheel."
msgstr "작은 돌아가는 방향-바퀴 만드는 데 쓰는 거다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTH_CHAIR_ROCKING_ITEM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTH_CHAIR_ROCKING_ITEM"
msgid "It remind Wolfgang of childhood."
msgstr "볼프강 어린 시절 생각난다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTH_KNIGHTHAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTH_KNIGHTHAT"
msgid "Wolfgang strong as horse!"
msgstr "볼프강은 말처럼 강하다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTH_KNIGHTSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTH_KNIGHTSHRINE.BURNT"
msgid "Poor horsey."
msgstr "불쌍한 말."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTH_KNIGHTSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTH_KNIGHTSHRINE.EMPTY"
msgid "What do horsey want?"
msgstr "말은 뭘 원하는 거지?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTH_KNIGHTSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTH_KNIGHTSHRINE.GENERIC"
msgid "Horsey happy now?"
msgstr "말 이제 행복하나?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTH_KNIGHTSTICK
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTH_KNIGHTSTICK"
msgid "Wolfgang love to gallop."
msgstr "볼프강은 목마 놀이 좋아한다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTH_LANCE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTH_LANCE"
msgid "A mighty lance for Sir Wolfgang?"
msgstr "볼프강 경을 위한 강력한 창인가?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTP_FOOD1
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTP_FOOD1"
msgid "Make Wolfgang mighty!"
msgstr "볼프강 강하게 해 준다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTP_FOOD2
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTP_FOOD2"
msgid "Is not for Wolfgang."
msgstr "볼프강 먹는 거 아니다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTP_FOOD3
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTP_FOOD3"
msgid "Is for making Wolfgang little bit mighty."
msgstr "볼프강을 조금 강하게 해 준다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTR_DECOR_1.GENERAL
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTR_DECOR_1.GENERAL"
msgid "Wolfgang likes rabbit night light."
msgstr "볼프강은 토끼 등불 좋아한다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTR_DECOR_1.OUT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTR_DECOR_1.OUT"
msgid "Rabbit light ran out!"
msgstr "토끼 불이 꺼졌다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTR_DECOR_1_ITEM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTR_DECOR_1_ITEM"
msgid "Wolfgang will find good place for rabbit light."
msgstr "볼프강 토끼 불 놓기 좋은 곳 찾을 거다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTR_DECOR_2.GENERAL
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTR_DECOR_2.GENERAL"
msgid "Wolfgang likes rabbit night light."
msgstr "볼프강은 토끼 등불 좋아한다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTR_DECOR_2.OUT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTR_DECOR_2.OUT"
msgid "Rabbit light ran out!"
msgstr "토끼 불이 꺼졌다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTR_DECOR_2_ITEM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTR_DECOR_2_ITEM"
msgid "Wolfgang will find good place for rabbit light."
msgstr "볼프강 토끼 불 놓기 좋은 곳 찾을 거다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTR_FIGHTRING_BELL.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTR_FIGHTRING_BELL.GENERIC"
msgid "Is time for pillow battle, yes?"
msgstr "이제 베개로 싸울 때인 거지?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTR_FIGHTRING_BELL.PLAYING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTR_FIGHTRING_BELL.PLAYING"
msgid "Haha! Is good fun!"
msgstr "하하! 되게 재밌다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTR_FIGHTRING_KIT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTR_FIGHTRING_KIT"
msgid "Do not worry, Wolfgang will put it in good spot."
msgstr "걱정 마, 볼프강이 적당한 곳에 둘 거야."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTR_FOOD1
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTR_FOOD1"
msgid "Wolfgang likes the funny rabbit cake."
msgstr "볼프강은 웃긴 토끼 케이크 좋아한다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTR_FOOD2
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTR_FOOD2"
msgid "Ah. Wolfgang expected cheese."
msgstr "아. 볼프강은 치즈 맛 날 줄 알았는데."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTR_FOOD3
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTR_FOOD3"
msgid "Is funny wobble dessert."
msgstr "재밌는 말캉말캉 디저트다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTR_FOOD4
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTR_FOOD4"
msgid "Sticky chew puffs."
msgstr "끈적끈적하고 쫄깃한 덩어리다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTR_RABBITSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTR_RABBITSHRINE.BURNT"
msgid "Goodbye rabbit."
msgstr "잘 가 토끼야."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTR_RABBITSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTR_RABBITSHRINE.EMPTY"
msgid "Rabbit is hungry! Wolfgang understands this."
msgstr "토끼가 배고프다! 볼프강 잘 알겠다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTR_RABBITSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTR_RABBITSHRINE.GENERIC"
msgid "Is well-fed rabbit!"
msgstr "토끼가 배부르다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTR_TOKEN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTR_TOKEN"
msgid "Who will face mighty Wolfgang in pillow fight?"
msgstr "누가 볼프강과 베개싸움 붙을 테냐?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTS_LANTERN_POST.BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTS_LANTERN_POST.BURNT"
msgid "It was good post."
msgstr "좋은 등불이었는데."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTS_LANTERN_POST.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTS_LANTERN_POST.GENERIC"
msgid "Post is both dazzling and useful, like Wolfgang."
msgstr "기둥이 번쩍번쩍하고 쓸모도 있다. 볼프강처럼."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTS_LANTERN_POST_ITEM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTS_LANTERN_POST_ITEM"
msgid "Wolfgang light up the dance floor."
msgstr "불프강이 무도장을 빛내주지."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTS_SNAKESHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTS_SNAKESHRINE.BURNT"
msgid "Wolfgang not crying. Just smokey."
msgstr "우는 거 아니다. 연기 때문에 눈 매운 거다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTS_SNAKESHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTS_SNAKESHRINE.EMPTY"
msgid "Are you hungry, wormy?"
msgstr "배고프니, 지렁아?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTS_SNAKESHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTS_SNAKESHRINE.GENERIC"
msgid "Wormy treats for Wolfgang!"
msgstr "지렁이가 볼프강에게 선물을 준다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTS_WORM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOTS_WORM"
msgid "Hey, worm not allowed up here!"
msgstr "뭐야, 지렁이는 올라오면 안 돼!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOT_CATCOONSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOT_CATCOONSHRINE.BURNT"
msgid "Poor tiny kitty."
msgstr "불쌍한 작은 야옹이."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOT_CATCOONSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOT_CATCOONSHRINE.EMPTY"
msgid "Is wanting little feather, Wolfgang will help!"
msgstr "작은 깃털을 원한다, 볼프강이 도와준다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOT_CATCOONSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YOT_CATCOONSHRINE.GENERIC"
msgid "Looks like tiny kitty, but shiny."
msgstr "작은 야옹이 같은데 반짝반짝하다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE_GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE_GENERIC"
msgid "What is this thing?"
msgstr "이게 뭐지?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE_PLANTHAPPY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE_PLANTHAPPY"
msgid "Is happy, yes?"
msgstr "행복해 한다, 맞지?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE_PLANTSTRESSED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE_PLANTSTRESSED"
msgid "Is bothered by something..."
msgstr "무언가 귀찮게 하는 게 있다..."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE_PLANTSTRESSORFAMILY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE_PLANTSTRESSORFAMILY"
msgid "Is lonely, needs family!"
msgstr "외로워 한다. 가족 필요하다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE_PLANTSTRESSORHAPPINESS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE_PLANTSTRESSORHAPPINESS"
msgid "Wolfgang will have a little chat with plant."
msgstr "볼프강 식물이랑 잠깐 이야기해야 할 거다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE_PLANTSTRESSORKILLJOYS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE_PLANTSTRESSORKILLJOYS"
msgid "Wolfgang should tidy up garden."
msgstr "볼프강은 밭 정리 해야 한다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE_PLANTSTRESSORMOISTURE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE_PLANTSTRESSORMOISTURE"
msgid "Plant needs a drink!"
msgstr "식물에게 마실 게 필요하다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE_PLANTSTRESSORNUTRIENTS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE_PLANTSTRESSORNUTRIENTS"
msgid "Is hungry! What do plants like to eat..."
msgstr "배고파 한다! 식물들이 뭘 먹더라..."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE_PLANTSTRESSOROVERCROWDING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE_PLANTSTRESSOROVERCROWDING"
msgid "Is not enough space for so many plants!"
msgstr "식물이 너무 많아서 공간이 모자라다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE_PLANTSTRESSORSEASON
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE_PLANTSTRESSORSEASON"
msgid "Is not good season for this one."
msgstr "이 녀석에게 좋은 계절이 아니야."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE_PLANTVERYSTRESSED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE_PLANTVERYSTRESSED"
msgid "Is very unhappy, many problems in its life."
msgstr "엄청 불행해 한다, 삶의 고민이 너무 많다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE_SMOLDERING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE_SMOLDERING"
msgid "Is almost fire."
msgstr "거의 불이다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE_TOODARK
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE_TOODARK"
msgid "Help friends! Save Wolfgang from dark!"
msgstr "도와줘 친구들! 볼프강 어둠으로부터 구해줘!"

#. STRINGS.CHARACTERS.WOLFGANG.EAT_FOOD.TALLBIRDEGG_CRACKED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.EAT_FOOD.TALLBIRDEGG_CRACKED"
msgid "This egg too crunchy."
msgstr "이 달걀 너무 바삭한데."

#. STRINGS.CHARACTERS.WOLFGANG.EAT_FOOD.WINTERSFEASTFUEL
msgctxt "STRINGS.CHARACTERS.WOLFGANG.EAT_FOOD.WINTERSFEASTFUEL"
msgid "Remind Wolfgang of old country..."
msgstr "볼프강 고향 생각 난다..."

#. STRINGS.CHARACTERS.WOLFGANG.QUAGMIRE_ANNOUNCE_LOSE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.QUAGMIRE_ANNOUNCE_LOSE"
msgid "Sky beast is mad!"
msgstr "하늘 짐승이 화났다!"

#. STRINGS.CHARACTERS.WOLFGANG.QUAGMIRE_ANNOUNCE_MEALBURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.QUAGMIRE_ANNOUNCE_MEALBURNT"
msgid "Little meal cooked too long."
msgstr "작은 음식 너무 오래 익혔다."

#. STRINGS.CHARACTERS.WOLFGANG.QUAGMIRE_ANNOUNCE_NOTRECIPE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.QUAGMIRE_ANNOUNCE_NOTRECIPE"
msgid "That was not good recipe!"
msgstr "좋은 레시피가 아니었다!"

#. STRINGS.CHARACTERS.WOLFGANG.QUAGMIRE_ANNOUNCE_WIN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.QUAGMIRE_ANNOUNCE_WIN"
msgid "Is time to leave. Goodbye, good food!"
msgstr "떠날 시간이다. 잘 있어, 맛있는 음식들아!"

#. STRINGS.CHARACTERS.WOLFGANG.WENDY_SKILLTREE_EASTEREGG
msgctxt "STRINGS.CHARACTERS.WOLFGANG.WENDY_SKILLTREE_EASTEREGG"
msgid "only_used_by_wendy"
msgstr ""

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.ACTIVATE.CARNIVAL_HOST_HERE
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.ACTIVATE.CARNIVAL_HOST_HERE"
msgid "I thought I saw that bird creepin' around here somewhere..."
msgstr "그 새자식 여기 어디 어슬렁거리던 것 같은데..."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.ACTIVATE.EMPTY_CATCOONDEN
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.ACTIVATE.EMPTY_CATCOONDEN"
msgid "Nothin' really in here, eh?"
msgstr "뭔 티끌도 없는데?"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.ACTIVATE.HOSTBUSY
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.ACTIVATE.HOSTBUSY"
msgid "What is that bird up to..."
msgstr "저 새자식 뭐할라고..."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.ACTIVATE.KITCOON_HIDEANDSEEK_NOT_ENOUGH_HIDERS
msgctxt ""
"STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.ACTIVATE.KITCOON_HIDEANDSEEK_NOT_ENOUGH_HIDERS"
msgid "I don't think there's enough of them to make a real game of it."
msgstr "제대로 놀기엔 쪽수가 모자라겠는데."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.ACTIVATE.KITCOON_HIDEANDSEEK_NOT_ENOUGH_HIDING_SPOTS
msgctxt ""
"STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.ACTIVATE.KITCOON_HIDEANDSEEK_NOT_ENOUGH_HIDING_SPOTS"
msgid "Not many places to hide around here, eh?"
msgstr "숨을 데 좀 모자라지 않아?"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.ACTIVATE.KITCOON_HIDEANDSEEK_ONE_GAME_PER_DAY
msgctxt ""
"STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.ACTIVATE.KITCOON_HIDEANDSEEK_ONE_GAME_PER_DAY"
msgid "How aboot we do it again another day?"
msgstr "오늘은 그만 하는 게 어때?"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.ACTIVATE.LOCKED_GATE
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.ACTIVATE.LOCKED_GATE"
msgid "Guess we need a key."
msgstr "열쇠 있어야겠는데."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.ACTIVATE.MANNEQUIN_EQUIPSWAPFAILED
msgctxt ""
"STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.ACTIVATE.MANNEQUIN_EQUIPSWAPFAILED"
msgid "Guess that won't work, eh?"
msgstr "잉? 그건 안 되겠는데."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.ACTIVATE.NOCARNIVAL
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.ACTIVATE.NOCARNIVAL"
msgid "Whew, those birds finally skedaddled."
msgstr "아휴, 새자식들 드디어 꺼졌네."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.ACTIVATE.NOKELP
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.ACTIVATE.NOKELP"
msgid "only_used_by_wurt"
msgstr ""

