#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_PETRIFED_TREES
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_PETRIFED_TREES"
msgid "Trees! Getting! STRONG!"
msgstr "나무들이! 점점! 강해진다!!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_PICK_DISEASE_WARNING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_PICK_DISEASE_WARNING"
msgid "Bah! Tiny plant is smell terrible!"
msgstr "으! 작은 식물 냄새 독하다!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_PIRATES_ARRIVE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_PIRATES_ARRIVE"
