msgstr "어어, 볼프강은 나중에..."

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_NO_ABIGAIL_FLOWER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_NO_ABIGAIL_FLOWER"
msgid "only_used_by_wendy"
msgstr ""

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_NO_TRAP
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_NO_TRAP"
msgid "Easy like lift weights."
msgstr "아령 드는 것처럼 쉬워."

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_OCEANFISHING_BADCAST
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_OCEANFISHING_BADCAST"
