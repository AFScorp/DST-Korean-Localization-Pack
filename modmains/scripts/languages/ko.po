msgstr "차가운 불이라고? 이해가 잘 안 되는데."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COLDFIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COLDFIREPIT.HIGH"
msgid "Properly roaring."
msgstr "괜찮게 타네."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COLDFIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COLDFIREPIT.LOW"
msgid "It's gonna go out soon."
msgstr "곧 꺼지겠네."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COLDFIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COLDFIREPIT.NORMAL"
