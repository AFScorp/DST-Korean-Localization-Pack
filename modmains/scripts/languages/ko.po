msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SLINGSHOTAMMO_MOONGLASS"
msgid "Remember to clean up after yourself, dear."
msgstr "있던 자리는 꼭 정리하려무나."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SLINGSHOTAMMO_POOP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SLINGSHOTAMMO_POOP"
msgid "Oh dear..."
msgstr "맙소사..."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SLINGSHOTAMMO_PUREBRILLIANCE
msgctxt ""
"STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SLINGSHOTAMMO_PUREBRILLIANCE"
msgid "Remember to clean up after yourself, dear."
msgstr "있던 자리는 꼭 정리하려무나."

