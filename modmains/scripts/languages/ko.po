msgstr "배가 너무 차서 터질 것 같아!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PEPPER_COOKED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PEPPER_COOKED"
msgid "I bet it's spicy."
msgstr "이건 매울 것 같아."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PEPPER_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PEPPER_OVERSIZED"
