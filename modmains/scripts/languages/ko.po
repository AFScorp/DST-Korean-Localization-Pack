msgstr "상자가 기분이 좋대!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_SCRAPBOOK_FULL
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_SCRAPBOOK_FULL"
