#. STRINGS.SKIN_DESCRIPTIONS.mast_rose_item
msgctxt "STRINGS.SKIN_DESCRIPTIONS.mast_rose_item"
msgid "n/a"
msgstr "n/a"

#. STRINGS.SKIN_DESCRIPTIONS.mastupgrade_lightningrod_item_nautical
msgctxt "STRINGS.SKIN_DESCRIPTIONS.mastupgrade_lightningrod_item_nautical"
msgid "This sea monster has an appetite for electricity."
msgstr "전기를 먹으며 살아가는 바다 괴물."

#. STRINGS.SKIN_DESCRIPTIONS.mastupgrade_lightningrod_nautical
msgctxt "STRINGS.SKIN_DESCRIPTIONS.mastupgrade_lightningrod_nautical"
msgid "This sea monster has an appetite for electricity."
msgstr "전기를 먹으며 살아가는 바다 괴물."

#. STRINGS.SKIN_DESCRIPTIONS.mastupgrade_lightningrod_nautical_top
msgctxt "STRINGS.SKIN_DESCRIPTIONS.mastupgrade_lightningrod_nautical_top"
msgid "This sea monster has an appetite for electricity."
msgstr "전기를 먹으며 살아가는 바다 괴물."

#. STRINGS.SKIN_DESCRIPTIONS.mastupgradelamp_item_nautical
msgctxt "STRINGS.SKIN_DESCRIPTIONS.mastupgradelamp_item_nautical"
msgid "n/a"
msgstr "n/a"

#. STRINGS.SKIN_DESCRIPTIONS.mastupgradelamp_nautical
msgctxt "STRINGS.SKIN_DESCRIPTIONS.mastupgradelamp_nautical"
msgid "The beauty of the sea will guide your way with this iridescent lamp."
msgstr "바다의 아름다움이 여러분을 오색찬란한 램프로써 인도합니다."

#. STRINGS.SKIN_DESCRIPTIONS.meatrack_ancient
msgctxt "STRINGS.SKIN_DESCRIPTIONS.meatrack_ancient"
msgid ""
"Archaeologists speculate that the meat found on this drying rack was way "
"past the expiration date."
msgstr "고고학자들의 추측에 따르면 이 건조대에서 발견되었던 고기는 유통기한이 지났다고 합니다."

#. STRINGS.SKIN_DESCRIPTIONS.meatrack_butcher
msgctxt "STRINGS.SKIN_DESCRIPTIONS.meatrack_butcher"
msgid ""
"A very normal piece of food prep equipment that isn't disconcerting at all."
msgstr "전혀 당황스럽지 않고 아주 평범한 음식 가공 장비."

#. STRINGS.SKIN_DESCRIPTIONS.meatrack_circus
msgctxt "STRINGS.SKIN_DESCRIPTIONS.meatrack_circus"
msgid "An exercise bar is the perfect thing for toughening up your food."
msgstr "음식을 튼튼하게 만드는 데에는 철봉만한 게 없죠."

#. STRINGS.SKIN_DESCRIPTIONS.meatrack_hermit_coral
msgctxt "STRINGS.SKIN_DESCRIPTIONS.meatrack_hermit_coral"
msgid "Add a deliciously fishy kick to your jerky!"
msgstr "육포에 생선의 감칠맛을 더하세요!"

#. STRINGS.SKIN_DESCRIPTIONS.meatrack_hermit_multi_coral
msgctxt "STRINGS.SKIN_DESCRIPTIONS.meatrack_hermit_multi_coral"
msgid "Add a large amount of deliciously fishy kick to your jerky!"
msgstr "육포에 생선의 감칠맛을 가득 더하세요!"

#. STRINGS.SKIN_DESCRIPTIONS.meatrack_hermit_multi_yule
msgctxt "STRINGS.SKIN_DESCRIPTIONS.meatrack_hermit_multi_yule"
msgid "n/a"
msgstr "n/a"

#. STRINGS.SKIN_DESCRIPTIONS.meatrack_hermit_yule
msgctxt "STRINGS.SKIN_DESCRIPTIONS.meatrack_hermit_yule"
msgid "n/a"
msgstr "n/a"

#. STRINGS.SKIN_DESCRIPTIONS.meatrack_victorian
msgctxt "STRINGS.SKIN_DESCRIPTIONS.meatrack_victorian"
msgid "A distinguished display for fine dried meats."
msgstr "기품 있는 고급 건조육 진열대."

#. STRINGS.SKIN_DESCRIPTIONS.mermhat_clown
msgctxt "STRINGS.SKIN_DESCRIPTIONS.mermhat_clown"
msgid "So so incognito!"
msgstr "정말정말 감쪽같군요!"

#. STRINGS.SKIN_DESCRIPTIONS.mermhouse_crafted_fantasy
msgctxt "STRINGS.SKIN_DESCRIPTIONS.mermhouse_crafted_fantasy"
msgid "This charming home doesn't leave mushroom for improvement."
msgstr "이보다 더 나을 수가 없을 정도로 버섯날 수 없는 매력을 가진 집."

#. STRINGS.SKIN_DESCRIPTIONS.mermhouse_crafted_mystical
msgctxt "STRINGS.SKIN_DESCRIPTIONS.mermhouse_crafted_mystical"
msgid "The wisdom of the Merms is beyond our understanding, and theirs too."
msgstr "어인들의 지혜를 우리로서는 헤아릴 수 없습니다. 그들로서도 마찬가지고요."

#. STRINGS.SKIN_DESCRIPTIONS.mermhouse_crafted_swamp
msgctxt "STRINGS.SKIN_DESCRIPTIONS.mermhouse_crafted_swamp"
msgid "When visiting the swamp, these cute little houses are a mossy."
msgstr "늪을 방문할 때, 이 귀여운 작은 집들은 이끼가 끼곤 합니다."

#. STRINGS.SKIN_DESCRIPTIONS.mermwatchtower_mystical
msgctxt "STRINGS.SKIN_DESCRIPTIONS.mermwatchtower_mystical"
msgid "Home of the King's Special Florpces."
msgstr "왕이 꼬륵고 고른 정예병들의 집."

#. STRINGS.SKIN_DESCRIPTIONS.mermwatchtower_swamp
msgctxt "STRINGS.SKIN_DESCRIPTIONS.mermwatchtower_swamp"
msgid "For the glort-y of the King!"
msgstr "왕의 영-괅을 위해!"

#. STRINGS.SKIN_DESCRIPTIONS.mighty_gym_ancient
msgctxt "STRINGS.SKIN_DESCRIPTIONS.mighty_gym_ancient"
msgid "Master the ancient art of lifting heavy objects."
msgstr "고대의 쇠질 기술을 연마해 보세요."

