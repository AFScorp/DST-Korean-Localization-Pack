msgstr "씨앗 한 줌이야."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COSTUME_BLACKSMITH_BODY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COSTUME_BLACKSMITH_BODY"
