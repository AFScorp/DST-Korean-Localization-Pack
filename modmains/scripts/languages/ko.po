"Weight: {weight}\n"
"Caught by: {owner}"
msgstr ""
"무게: {weight}\n"
"잡은 사람: {owner}"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.TROPHYSCALE_FISH.HAS_ITEM_HEAVY
msgctxt ""
"STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.TROPHYSCALE_FISH.HAS_ITEM_HEAVY"
msgid ""
"Weight: {weight}\n"
"Caught by: {owner}\n"
"Quite the accomplishment!"
msgstr ""
"무게: {weight}\n"
"잡은 사람: {owner}\n"
"정말 훌륭하구나!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.TROPHYSCALE_FISH.OWNER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.TROPHYSCALE_FISH.OWNER"
msgid ""
"Weight: {weight}\n"
"Caught by: {owner}\n"
"Oh ho! I seem to be the victor!"
msgstr ""
"무게: {weight}\n"
"잡은 사람: {owner}\n"
"오호! 내가 이긴 것 같구나!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.TROPHYSCALE_FISH.OWNER_HEAVY
msgctxt ""
"STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.TROPHYSCALE_FISH.OWNER_HEAVY"
msgid ""
"Weight: {weight}\n"
"Caught by: {owner}\n"
"Fishing is really quite easy, isn't it?"
msgstr ""
"무게: {weight}\n"
"잡은 사람: {owner}\n"
"낚시란 건 꽤나 쉬운 것 같지 않니?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.BURNING
msgctxt ""
"STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.BURNING"
msgid "Oh dear..."
msgstr "오, 세상에..."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.BURNT
msgctxt ""
"STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.BURNT"
