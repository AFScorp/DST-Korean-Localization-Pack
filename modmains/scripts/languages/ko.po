msgstr "머리에 쓰는 게 아냐."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_CENTIPEDE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_CENTIPEDE"
