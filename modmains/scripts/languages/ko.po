msgstr "오, 이런."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CABBAGEROLLS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CABBAGEROLLS"
