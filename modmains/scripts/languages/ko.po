msgstr "다시 자랄 것 같지는 않아."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_ONION
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_ONION"
msgid "Looks crunchy."
msgstr "아삭아삭해 보여."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_ONION_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_ONION_COOKED"
msgid "A successful chemical reaction."
msgstr "성공적인 화학 반응."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_ONION_SEEDS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_ONION_SEEDS"
msgid "A handful of odd seeds."
msgstr "이상한 씨앗 한 줌이야."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_OVEN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_OVEN"
