msgstr "회오리 무늬야!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SOIL_AMENDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SOIL_AMENDER.GENERIC"
