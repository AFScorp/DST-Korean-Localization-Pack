msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.BURNT"
msgid "Is all burned up."
msgstr "다 타 버렸다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.GENERIC
msgctxt ""
"STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.GENERIC"
msgid "Fixing lady doesn't need machine, Wolfgang can help carry!"
msgstr "고치는 여자는 기계 없어도 돼, 볼프강이 들어주면 되니까!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.OFF
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.OFF"
msgid "Is not working."
msgstr "안 움직인다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTERHAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTERHAT"
msgid "It make ears happy in cold!"
msgstr "추위에 귀를 행복하게 해주는군!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTEROMETER.BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTEROMETER.BURNT"
msgid "Flames go up! Measure machine go down!"
msgstr "불꽃 일어난다! 재는 기계 쓰러진다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTEROMETER.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTEROMETER.GENERIC"
msgid "Cold go up! Red go down!"
msgstr "추위 올라온다! 빨간 거 내려간다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTERSFEASTFUEL
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTERSFEASTFUEL"
msgid "Is making Wolfgang think of friends."
msgstr "볼프강 친구들 생각나."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTERSFEASTOVEN.ALMOST_DONE_COOKING
msgctxt ""
"STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTERSFEASTOVEN.ALMOST_DONE_COOKING"
msgid "Is almost done..."
msgstr "거의 다 됐다..."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTERSFEASTOVEN.COOKING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTERSFEASTOVEN.COOKING"
msgid "Is making Wolfgang's mouth water."
msgstr "볼프강 입에 침 고인다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTERSFEASTOVEN.DISH_READY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTERSFEASTOVEN.DISH_READY"
msgid "Wolfgang will share with all his friends!"
msgstr "볼프강 친구들이랑 같이 나눠 먹고 싶다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTERSFEASTOVEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTERSFEASTOVEN.GENERIC"
msgid "Oven needs mighty fuel!"
msgstr "화로에 강력한 땔감이 필요하다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTER_FOOD1
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTER_FOOD1"
msgid "Little man will crumble under my mighty teeth!"
msgstr "작은 사람 내 강력한 이빨에 부서진다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTER_FOOD2
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTER_FOOD2"
msgid "Does Wolfgang have sugar in moustache?"
msgstr "볼프강 수염에 설탕 묻었나?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTER_FOOD3
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTER_FOOD3"
msgid "Little sugar stick."
msgstr "작은 설탕 막대기군."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTER_FOOD4
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTER_FOOD4"
msgid "Wolfgang does not trust little fruit loaf."
msgstr "볼프강 작은 과일케이크 믿지 않는다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTER_FOOD5
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTER_FOOD5"
msgid "Ha! Is not real log, Wolfgang was not fooled!"
msgstr "하! 진짜 통나무 아니잖아, 볼프강 안 속았다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTER_FOOD6
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTER_FOOD6"
msgid "Tiny yummy cakething make strong Wolfgang."
msgstr "작고 맛난 케이크 강한 볼프강 만든다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTER_FOOD7
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTER_FOOD7"
msgid "Little fruit is sweet and tasty!"
msgstr "작은 과일은 달고 맛있다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTER_FOOD8
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTER_FOOD8"
msgid "Wolfgang likes feeling cozy."
msgstr "볼프강은 아늑한 느낌을 좋아해."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTER_FOOD9
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTER_FOOD9"
msgid "Is much protein inside, yes?"
msgstr "단백질 많이 있지, 그렇지?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTER_ORNAMENT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTER_ORNAMENT"
msgid "Is so small in Wolfgang's hand."
msgstr "볼프강의 손에는 너무 작군."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTER_ORNAMENTBOSS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTER_ORNAMENTBOSS"
msgid "Pretty little token of mightiness!"
msgstr "작고 예쁜 힘의 상징이다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTER_ORNAMENTFORGE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTER_ORNAMENTFORGE"
msgid "Decoration of mighty enemy."
msgstr "강력한 적 장식이다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTER_ORNAMENTGORGE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTER_ORNAMENTGORGE"
msgid "Hello, little friend!"
msgstr "안녕, 작은 친구!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTER_ORNAMENTLIGHT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTER_ORNAMENTLIGHT"
msgid "Glass ball of twinkly light!"
msgstr "반짝반짝 빛이 든 유리구슬이다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTER_ORNAMENTPEARL
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTER_ORNAMENTPEARL"
msgid "It make Wolfgang warm inside."
msgstr "볼프강 마음이 따뜻해진다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTER_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTER_TREE.BURNING"
msgid "Tree is not fireproof!"
msgstr "나무는 불에 강하지 않아!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTER_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTER_TREE.BURNT"
msgid "Happy tree is burn now."
msgstr "행복한 나무가 불탔어."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTER_TREE.CANDECORATE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTER_TREE.CANDECORATE"
msgid "Tree looks very happy!"
msgstr "나무가 아주 행복해 보여!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTER_TREE.YOUNG
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTER_TREE.YOUNG"
msgid "Is growing."
msgstr "자라고 있어."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTER_TREESTAND.BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTER_TREESTAND.BURNT"
msgid "Happy tree is burn now."
msgstr "행복한 나무가 불탔어."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTER_TREESTAND.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINTER_TREESTAND.GENERIC"
msgid "Very nice little pot!"
msgstr "아주 멋진 작은 화분이다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOBSTER_DEN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOBSTER_DEN"
msgid "Is home of the shellbeasts."
msgstr "껍데기 녀석들 사는 곳이다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOBSTER_MOONGLASS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOBSTER_MOONGLASS"
msgid "Is glassy shellbeast?"
msgstr "맨들맨들한 껍데기 녀석이야?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOBSTER_SHELLER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOBSTER_SHELLER"
msgid "Wolfgang will steer clear of the pinchers."
msgstr "볼프강 집게 조심할 거다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOBSTER_SHELLER_DEAD
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOBSTER_SHELLER_DEAD"
msgid "Wolfgang wish he had fearsome hand claws!"
msgstr "볼프강도 무서운 집게손 있었으면 좋겠다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOBSTER_SHELLER_DEAD_COOKED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOBSTER_SHELLER_DEAD_COOKED"
msgid "Is ready to eat now."
msgstr "먹을 준비가 됐다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOBYBIG.1
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOBYBIG.1"
msgid "Tiny dog grow mighty too!"
msgstr "작은 강아지도 엄청 강해졌다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOBYBIG.2
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOBYBIG.2"
msgid "Tiny dog grow mighty too!"
msgstr "작은 강아지도 엄청 강해졌다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOBYSMALL.1
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOBYSMALL.1"
msgid "Woby is good pup."
msgstr "워비는 좋은 강아지야."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOBYSMALL.2
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOBYSMALL.2"
msgid "Woby is good pup."
msgstr "워비는 좋은 강아지야."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOBY_TREAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOBY_TREAT"
msgid "Wolfgang know this for dog, but still..."
msgstr "이거 개 먹는 거란 건 알지만, 이거..."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOLFGANG.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOLFGANG.ATTACKER"
msgid "%s will make a worthy fight!"
msgstr "%s라면 가치 있는 상대가 되겠군!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOLFGANG.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOLFGANG.FIRESTARTER"
msgid "Wolfgang cannot trust even himself not to light fire!"
msgstr "볼프강은 스스로랑 한 불장난 안 한다는 약속도 못 지킨다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOLFGANG.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOLFGANG.GENERIC"
msgid "Hello friend %s! We must arm wrestle!"
msgstr "안녕 친구 %s! 우리 팔씨름 해봐야 한다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOLFGANG.GHOST
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOLFGANG.GHOST"
msgid "World needs more %s! I will get heart!"
msgstr "세상은 %s가 더 필요하다! 내가 심장을 가져오겠다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOLFGANG.MURDERER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOLFGANG.MURDERER"
msgid "We will see who is best Wolfgang! Raaa!"
msgstr "누가 최고의 볼프강인지 가려 보자! 으랴아앗!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOLFGANG.REVIVER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOLFGANG.REVIVER"
msgid "%s is nice man. Like me! Ha ha."
msgstr "%s는 좋은 남자다. 나처럼! 하하."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOLFGANG_WHISTLE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOLFGANG_WHISTLE"
msgid "Wolfgang is good teacher!"
msgstr "볼프강은 좋은 선생님이다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WONKEY.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WONKEY.ATTACKER"
msgid "Is angry monkey!"
msgstr "화난 원숭이다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WONKEY.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WONKEY.FIRESTARTER"
msgid "Is exactly why we stop having monkeys in circus!"
msgstr "이래서 극단에 원숭이 들여오면 안 돼!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WONKEY.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WONKEY.GENERIC"
msgid "Why does strange monkey follow Wolfgang?"
msgstr "왜 이상한 원숭이가 자꾸 볼프강 따라오지?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WONKEY.GHOST
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WONKEY.GHOST"
msgid "Poor monkey."
msgstr "불쌍한 원숭이."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WONKEY.MURDERER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WONKEY.MURDERER"
msgid "Wolfgang will stop this monkey business, for good!"
msgstr "볼프강이 원숭이 장난 멈출 거다, 어떻게든 할 거다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WONKEY.REVIVER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WONKEY.REVIVER"
msgid "Ah. Monkey is friend, yes?"
msgstr "아. 원숭이는 친구구나?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODCARVEDHAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODCARVEDHAT"
msgid "Is thick and sturdy, like Wolfgang's own mighty skull!"
msgstr "볼프강의 강력한 두개골처럼 두껍고 튼튼하다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.ATTACKER"
msgid "Does beardman %s want to fight?"
msgstr "수염남 %s가 싸우고 싶어하는 건가?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.BEAVER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.BEAVER"
msgid "The beard ate %s!"
msgstr "수염이 %s를 먹어 버렸다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.BEAVERGHOST
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.BEAVERGHOST"
msgid "Still have good moustache, %s."
msgstr "여전히 수염이 멋지다, %s."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.FIRESTARTER"
msgid "Be careful! Do not burn, beard!"
msgstr "조심해! 태우지 마라, 수염!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.GENERIC"
msgid "Is beard! Hello!"
msgstr "수염이다! 안녕!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.GHOST
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.GHOST"
msgid "Wolfgang will get heart for you, beard!"
msgstr "볼프강이 심장 갖다 주겠다, 수염!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.GOOSE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.GOOSE"
msgid "Beardman become birdman! Ha ha!"
msgstr "수염이 깃털이 되었다! 하하!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.GOOSEGHOST
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.GOOSEGHOST"
msgid "No fear birdman, Wolfgang will help!"
msgstr "걱정 마, 깃털, 볼프강이 도와 줄게!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.MOOSE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.MOOSE"
msgid "Something different about beardman today."
msgstr "오늘은 턱수염 조금 다르게 생겼다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.MOOSEGHOST
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.MOOSEGHOST"
msgid "Wolfgang will find heart for antlered beard."
msgstr "볼프강이 뿔난 턱수염한테 심장 찾아줄 거다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.MURDERER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.MURDERER"
msgid "Drop axe and fight, beardman!"
msgstr "도끼 내려놓고 싸우자, 수염남!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.REVIVER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.REVIVER"
msgid "%s is nice man with magnificent beard."
msgstr "%s는 멋진 수염을 가진 착한 남자다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOOD_CHAIR.BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOOD_CHAIR.BURNT"
msgid "Chair looks burnt and sad."
msgstr "의자가 타서 망가졌어."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOOD_CHAIR.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOOD_CHAIR.GENERIC"
msgid "Is tiny chair strong enough to hold Wolfgang?"
msgstr "작은 의자가 볼프강을 버틸 수 있을까?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOOD_CHAIR.OCCUPIED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOOD_CHAIR.OCCUPIED"
msgid "Do not worry, friend. Wolfgang will stand."
msgstr "걱정 마, 친구. 볼프강은 서 있을게."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOOD_TABLE.BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOOD_TABLE.BURNT"
msgid "Is not table anymore."
msgstr "더는 탁자가 아냐."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOOD_TABLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOOD_TABLE.GENERIC"
msgid "Is table."
msgstr "탁자다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOOD_TABLE.HAS_ITEM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOOD_TABLE.HAS_ITEM"
msgid "Is table."
msgstr "탁자다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WORM.DIRT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WORM.DIRT"
msgid "Is dirt moving?"
msgstr "흙이 움직여?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WORM.PLANT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WORM.PLANT"
msgid "Pretty light."
msgstr "예쁜 빛이군."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WORM.WORM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WORM.WORM"
msgid "Did not expect this!"
msgstr "이걸 기대한 건 아닌데!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WORMHOLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WORMHOLE.GENERIC"
msgid "Like soft pillow, growing on ground."
msgstr "땅에서 자라는 부드러운 베개 같아."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WORMHOLE.OPEN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WORMHOLE.OPEN"
msgid "It can not harm this man!"
msgstr "사람을 해칠 수 없어!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WORMHOLE_LIMITED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WORMHOLE_LIMITED"
msgid "Is not looking very good."
msgstr "그리 좋아 보이지 않는군."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WORMLIGHT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WORMLIGHT"
msgid "Pretty light."
