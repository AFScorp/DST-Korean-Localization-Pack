msgstr "평생 들어도 안 질리겠어."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PICKAXE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PICKAXE"
msgid "Rocks will be ours!"
msgstr "돌도 다 파'우리'거야!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PICKAXE_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PICKAXE_LUNARPLANT"
