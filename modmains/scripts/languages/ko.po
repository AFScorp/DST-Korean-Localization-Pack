msgstr "야! 너 맛있어 보인다!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KOALEFIG_TRUNK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KOALEFIG_TRUNK"
