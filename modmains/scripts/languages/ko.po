msgstr "과학을 움직일 재료가 필요해."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_OVEN_ITEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_OVEN_ITEM"
msgid "For scientifically burning things."
msgstr "과학적으로 불태우기 위해서."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_PARKSPIKE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_PARKSPIKE"
