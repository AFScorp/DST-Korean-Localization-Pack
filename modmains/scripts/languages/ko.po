msgstr "나 보고 싶었어?! 하하!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_TRAP_WENT_OFF
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_TRAP_WENT_OFF"
