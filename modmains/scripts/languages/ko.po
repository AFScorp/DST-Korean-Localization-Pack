msgstr "먹을 시간이다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_COOKPOT.EMPTY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_COOKPOT.EMPTY"
